<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ScreenPowerPro.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenPowerPro"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- =============================================
                 OBSIDIAN FLUX DARK - Design System Colors
                 Matched exactly to stitch HTML design files
                 ============================================= -->

            <!-- Base Colors -->
            <Color x:Key="AppBgColor">#12131A</Color>
            <Color x:Key="SurfaceDimColor">#12131A</Color>
            <Color x:Key="SurfaceContainerLowestColor">#0D0E15</Color>
            <Color x:Key="SurfaceContainerLowColor">#1A1B22</Color>
            <Color x:Key="SurfaceContainerColor">#1E1F27</Color>
            <Color x:Key="SurfaceHighColor">#292931</Color>
            <Color x:Key="SurfaceHighestColor">#34343C</Color>
            <Color x:Key="SurfaceBrightColor">#383941</Color>

            <!-- Primary — Periwinkle Blue/Purple -->
            <Color x:Key="PrimaryColor">#C0C1FF</Color>
            <Color x:Key="PrimaryFixedColor">#E1E0FF</Color>
            <Color x:Key="PrimaryContainerColor">#8083FF</Color>
            <Color x:Key="OnPrimaryColor">#1000A9</Color>
            <Color x:Key="InversePrimaryColor">#494BD6</Color>

            <!-- Tertiary — Soft Purple -->
            <Color x:Key="TertiaryColor">#D0BCFF</Color>
            <Color x:Key="TertiaryContainerColor">#A078FF</Color>

            <!-- Secondary — Soft Pink -->
            <Color x:Key="SecondaryColor">#FFB2B7</Color>
            <Color x:Key="SecondaryContainerColor">#B50036</Color>

            <!-- Error -->
            <Color x:Key="ErrorColor">#FFB4AB</Color>
            <Color x:Key="ErrorContainerColor">#93000A</Color>

            <!-- Text -->
            <Color x:Key="TextPrimaryColor">#E3E1EC</Color>
            <Color x:Key="TextSecondaryColor">#C7C4D7</Color>
            <Color x:Key="TextMutedColor">#908FA0</Color>

            <!-- Borders -->
            <Color x:Key="BorderColor">#464554</Color>
            <Color x:Key="BorderSubtleColor">#1A1B27</Color>

            <!-- Accent Gradients -->
            <Color x:Key="RecordRedStart">#DC2626</Color>
            <Color x:Key="RecordRedEnd">#EA580C</Color>
            <Color x:Key="PrimaryGradientStart">#C0C1FF</Color>
            <Color x:Key="PrimaryGradientEnd">#A078FF</Color>

            <!-- =============================================
                 BRUSHES
                 ============================================= -->
            <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}" />
            <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="{StaticResource SurfaceContainerLowestColor}" />
            <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="{StaticResource SurfaceContainerLowColor}" />
            <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}" />
            <SolidColorBrush x:Key="SurfaceHighBrush" Color="{StaticResource SurfaceHighColor}" />
            <SolidColorBrush x:Key="SurfaceHighestBrush" Color="{StaticResource SurfaceHighestColor}" />
            <SolidColorBrush x:Key="SurfaceBrightBrush" Color="{StaticResource SurfaceBrightColor}" />

            <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryColor}" />
            <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
            <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryColor}" />
            <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{StaticResource TertiaryContainerColor}" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />

            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
            <SolidColorBrush x:Key="RecordRedBrush" Color="{StaticResource RecordRedStart}" />

            <!-- Gradient Brushes -->
            <LinearGradientBrush x:Key="PrimaryButtonGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource PrimaryGradientStart}" Offset="0.0" />
                <GradientStop Color="{StaticResource PrimaryGradientEnd}" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="RecordButtonGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource RecordRedStart}" Offset="0.0" />
                <GradientStop Color="{StaticResource RecordRedEnd}" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Translucent brushes for glassmorphism panels -->
            <SolidColorBrush x:Key="GlassPanelBrush" Color="#991E1F27" />
            <SolidColorBrush x:Key="GlassNavBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="PrimaryGlowBrush" Color="#33C0C1FF" />
            <SolidColorBrush x:Key="TertiaryGlowBrush" Color="#33A078FF" />

            <!-- Semi-transparent for zoom pills -->
            <SolidColorBrush x:Key="ZoomPillBgBrush" Color="#4DA078FF" />
            <SolidColorBrush x:Key="ZoomPillBorderBrush" Color="#80D0BCFF" />
            <SolidColorBrush x:Key="VideoTrackBgBrush" Color="#338083FF" />
            <SolidColorBrush x:Key="VideoTrackBorderBrush" Color="#80C0C1FF" />

            <!-- Recording indicator -->
            <SolidColorBrush x:Key="PlayheadBrush" Color="{StaticResource SecondaryColor}" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
