<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenPowerPro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ScreenPowerPro"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ScreenPowerPro"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{StaticResource AppBgBrush}">
        <Grid.Resources>
            <Storyboard x:Name="LoadingMainAnimation" RepeatBehavior="Forever">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TransDot1Main" Storyboard.TargetProperty="Y">
                    <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                    <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="-10" KeySpline="0.25,0.1 0.25,1.0"/>
                    <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="0" KeySpline="0.25,0.1 0.25,1.0"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TransPillMain" Storyboard.TargetProperty="Y">
                    <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0"/>
                    <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="-10" KeySpline="0.25,0.1 0.25,1.0"/>
                    <SplineDoubleKeyFrame KeyTime="0:0:0.7" Value="0" KeySpline="0.25,0.1 0.25,1.0"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TransDot2Main" Storyboard.TargetProperty="Y">
                    <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/>
                    <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="-10" KeySpline="0.25,0.1 0.25,1.0"/>
                    <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0" KeySpline="0.25,0.1 0.25,1.0"/>
                    <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </Grid.Resources>
        <!-- Main Content Frame occupying full window canvas -->
        <Frame x:Name="RootFrame" />

        <!-- Indeterminate Processing Overlay -->
        <Grid x:Name="LoadingOverlay"
              Background="{StaticResource AppBgBrush}"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Canvas.ZIndex="999">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="#A078FF">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="TransDot1Main"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Border Width="36" Height="12" CornerRadius="6" Background="#00E5FF">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="TransPillMain"/>
                        </Border.RenderTransform>
                    </Border>
                    <Ellipse Width="12" Height="12" Fill="#FACC15">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="TransDot2Main"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </StackPanel>

                <!-- Status text -->
                <TextBlock x:Name="TbMainLoadingText"
                           Text="Editör Yükleniyor..."
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
