<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenPowerPro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ScreenPowerPro"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ScreenPowerPro"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource AppBgBrush}">
        <!-- Main Content Frame occupying full window canvas -->
        <Frame x:Name="RootFrame" />

        <!-- Indeterminate Processing Overlay (shown during Stop Recording → Editor transition) -->
        <Grid x:Name="LoadingOverlay"
              Background="#B2000000"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Canvas.ZIndex="999">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="20">

                <!-- Spinning ProgressRing -->
                <ProgressRing x:Name="ProcessingRing"
                              IsActive="False"
                              Width="64"
                              Height="64"
                              Foreground="#7C6FF7" />

                <!-- Status text -->
                <TextBlock Text="Lütfen bekleyin..."
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
