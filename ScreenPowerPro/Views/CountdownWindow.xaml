<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenPowerPro.Views.CountdownWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Geri Sayım">

    <Grid Background="#66000000">
        <!-- Center Animated Countdown Ring & Number -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
            <Border Width="160" Height="160" CornerRadius="80"
                Background="#33C0C1FF" BorderBrush="{StaticResource PrimaryAccentBrush}"
                BorderThickness="3">
                <TextBlock x:Name="TbCount" Text="3"
                    FontSize="80" FontWeight="Bold" FontFamily="Consolas"
                    Foreground="{StaticResource PrimaryAccentBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border Background="#9912131A" CornerRadius="8" Padding="16,8"
                BorderBrush="#22FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="Kayıt Başlıyor..." FontSize="16" FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
