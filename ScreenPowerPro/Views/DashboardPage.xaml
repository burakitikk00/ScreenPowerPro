<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenPowerPro.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBgBrush}">

    <Page.Resources>
        <!-- Mode card hover style -->
        <Style x:Key="ModeCardStyle" TargetType="Button">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="DevicePillSectionStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Atmospheric background glow -->
        <Ellipse
            Width="600" Height="600"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Margin="0,-100,0,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1AC0C1FF" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Main content centered -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="600" Margin="0,0,0,0">
            
            <!-- Glassmorphism Card -->
            <Border
                CornerRadius="24"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                Padding="40,36">
                <Border.Background>
                    <AcrylicBrush
                        TintColor="#1E1F27"
                        TintOpacity="0.85"
                        FallbackColor="#CC1E1F27" />
                </Border.Background>

                <StackPanel Spacing="28">

                    <!-- Header -->
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock
                            Text="Ready to Record"
                            FontSize="32"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            HorizontalAlignment="Center"
                            CharacterSpacing="-20"/>
                        <TextBlock
                            Text="Select your recording mode and configure devices."
                            FontSize="16"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Recording Mode 4-Grid -->
                    <Grid ColumnSpacing="14" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Full Screen -->
                        <Button x:Name="BtnFullScreen"
                            Grid.Column="0" Grid.Row="0"
                            Style="{StaticResource ModeCardStyle}"
                            Click="OnModeSelected"
                            Tag="FullScreen">
                            <Border CornerRadius="20" Padding="24,28">
                                <StackPanel Spacing="14" HorizontalAlignment="Center">
                                    <Border
                                        Width="64" Height="64" CornerRadius="32"
                                        Background="{StaticResource SurfaceContainerBrush}"
                                        BorderBrush="#1AFFFFFF" BorderThickness="1"
                                        HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="28"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Full Screen" FontSize="15" FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Custom Area -->
                        <Button x:Name="BtnCustomArea"
                            Grid.Column="1" Grid.Row="0"
                            Style="{StaticResource ModeCardStyle}"
                            Click="OnModeSelected"
                            Tag="CustomArea">
                            <Border CornerRadius="20" Padding="24,28">
                                <StackPanel Spacing="14" HorizontalAlignment="Center">
                                    <Border
                                        Width="64" Height="64" CornerRadius="32"
                                        Background="{StaticResource SurfaceContainerBrush}"
                                        BorderBrush="#1AFFFFFF" BorderThickness="1"
                                        HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE7C3;" FontSize="28"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Custom Area" FontSize="15" FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Window -->
                        <Button x:Name="BtnWindow"
                            Grid.Column="0" Grid.Row="1"
                            Style="{StaticResource ModeCardStyle}"
                            Click="OnModeSelected"
                            Tag="Window">
                            <Border CornerRadius="20" Padding="24,28">
                                <StackPanel Spacing="14" HorizontalAlignment="Center">
                                    <Border
                                        Width="64" Height="64" CornerRadius="32"
                                        Background="{StaticResource SurfaceContainerBrush}"
                                        BorderBrush="#1AFFFFFF" BorderThickness="1"
                                        HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE737;" FontSize="28"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Window" FontSize="15" FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Camera Only -->
                        <Button x:Name="BtnCamera"
                            Grid.Column="1" Grid.Row="1"
                            Style="{StaticResource ModeCardStyle}"
                            Click="OnModeSelected"
                            Tag="Camera">
                            <Border CornerRadius="20" Padding="24,28">
                                <StackPanel Spacing="14" HorizontalAlignment="Center">
                                    <Border
                                        Width="64" Height="64" CornerRadius="32"
                                        Background="{StaticResource SurfaceContainerBrush}"
                                        BorderBrush="#1AFFFFFF" BorderThickness="1"
                                        HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE722;" FontSize="28"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Camera Only" FontSize="15" FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>

                    <!-- Device Setup Pill -->
                    <Border
                        CornerRadius="999"
                        Background="{StaticResource SurfaceHighBrush}"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="1"
                        Padding="6">
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Camera -->
                            <Button Grid.Column="0"
                                x:Name="BtnCameraDevice"
                                Style="{StaticResource DevicePillSectionStyle}"
                                CornerRadius="999"
                                HorizontalAlignment="Stretch"
                                Click="OnCameraDeviceClicked">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE714;" FontSize="18"
                                        Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="CAMERA" FontSize="10" FontWeight="Bold"
                                            CharacterSpacing="50"
                                            Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TbCameraName" Text="No Camera"
                                            FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                            TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="14"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>
                            </Button>

                            <!-- Divider -->
                            <Rectangle Grid.Column="1" Width="1" Fill="#1AFFFFFF" Margin="0,8"/>

                            <!-- Microphone -->
                            <Button Grid.Column="2"
                                x:Name="BtnMicDevice"
                                Style="{StaticResource DevicePillSectionStyle}"
                                CornerRadius="999"
                                HorizontalAlignment="Stretch"
                                Click="OnMicDeviceClicked">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE720;" FontSize="18"
                                        Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="MICROPHONE" FontSize="10" FontWeight="Bold"
                                            CharacterSpacing="50"
                                            Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TbMicName" Text="Default"
                                            FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                            TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="14"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>
                            </Button>

                            <!-- Divider -->
                            <Rectangle Grid.Column="3" Width="1" Fill="#1AFFFFFF" Margin="0,8"/>

                            <!-- System Audio -->
                            <Button Grid.Column="4"
                                x:Name="BtnAudioDevice"
                                Style="{StaticResource DevicePillSectionStyle}"
                                CornerRadius="999"
                                HorizontalAlignment="Stretch"
                                Click="OnAudioDeviceClicked">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE767;" FontSize="18"
                                        Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="SYSTEM AUDIO" FontSize="10" FontWeight="Bold"
                                            CharacterSpacing="50"
                                            Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TbAudioName" Text="Default"
                                            FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                            TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Options Row (Cursor Hide + Audio toggle) -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource SurfaceContainerBrush}"
                            CornerRadius="12" Padding="16,12"
                            BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Hide Cursor" FontSize="13" FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Mouse will not appear in video"
                                        FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="TsHideCursor" Grid.Column="1"
                                    IsOn="True" OnContent="" OffContent=""
                                    VerticalAlignment="Center" Margin="0"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource SurfaceContainerBrush}"
                            CornerRadius="12" Padding="16,12"
                            BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Record Audio" FontSize="13" FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Capture system and mic audio"
                                        FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="TsRecordAudio" Grid.Column="1"
                                    IsOn="True" OnContent="" OffContent=""
                                    VerticalAlignment="Center" Margin="0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Start Recording Button -->
                    <Button
                        x:Name="BtnStartRecording"
                        Click="OnStartRecording"
                        HorizontalAlignment="Center"
                        Height="56"
                        CornerRadius="28"
                        Padding="48,0"
                        BorderThickness="1"
                        BorderBrush="#33FFFFFF">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#DC2626" Offset="0.0"/>
                                <GradientStop Color="#EA580C" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Ellipse Width="12" Height="12" Fill="White">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <TextBlock Text="Start Recording"
                                FontSize="18" FontWeight="SemiBold"
                                Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <!-- Recent Recordings (quick access) -->
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RECENT RECORDINGS"
                                FontSize="10" FontWeight="Bold"
                                CharacterSpacing="60"
                                Foreground="{StaticResource TextMutedBrush}"
                                VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="View All"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource PrimaryAccentBrush}"
                                FontSize="12" Padding="8,4"
                                Click="OnViewAllClicked"/>
                        </Grid>

                        <ItemsControl x:Name="RecentRecordingsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Tag="{Binding}"
                                        Click="OnOpenRecentRecording"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="12,10"
                                        CornerRadius="10"
                                        Margin="0,0,0,4">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36"
                                                CornerRadius="8"
                                                Background="{StaticResource SurfaceHighBrush}">
                                                <FontIcon Glyph="&#xE714;" FontSize="16"
                                                    Foreground="{StaticResource PrimaryAccentBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Name}"
                                                    FontSize="13" FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DateDisplay}"
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <Border x:Name="EmptyRecordingsState"
                            Background="{StaticResource SurfaceContainerBrush}"
                            CornerRadius="12" Padding="20"
                            BorderBrush="#1AFFFFFF" BorderThickness="1"
                            Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xE714;" FontSize="28"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    HorizontalAlignment="Center"/>
                                <TextBlock Text="No recordings yet"
                                    FontSize="14" FontWeight="SemiBold"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    HorizontalAlignment="Center"/>
                                <TextBlock Text="Start your first recording above"
                                    FontSize="12"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
