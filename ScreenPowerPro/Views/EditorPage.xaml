                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Cursor Sounds & Idle Toggles -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbCursorClickSound" Text="Cursor Click Sound" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsCursorSound" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.CursorClickSound, Mode=TwoWay}"
                                            Toggled="OnCursorSoundToggled"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                    <!-- Click Sound Details (Tone selector & Volume) -->
                                    <StackPanel x:Name="PanelClickSoundDetails" Spacing="8" Margin="0,0,0,4">
                                        <TextBlock Text="Tıklama Sesi Tonu" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <ComboBox x:Name="ComboClickSounds" HorizontalAlignment="Stretch"
                                            SelectionChanged="OnComboClickSoundsSelectionChanged"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Ses Seviyesi" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TbCursorSoundVolText" Grid.Column="1" Text="80%" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Slider x:Name="SliderCursorClickVol" Minimum="0" Maximum="100"
                                            Value="{x:Bind ViewModel.CursorClickVolume, Mode=TwoWay}"
                                            ValueChanged="OnCursorClickVolSliderChanged"/>
                                        <Button x:Name="BtnTestClickSound" Content="🔊 Sesi Dinle" HorizontalAlignment="Stretch" FontSize="11"
                                            Click="OnTestClickSoundClicked"/>
                                    </StackPanel>
                                    <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbHideCursorIdle" Text="Hide Cursor When Idle" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsHideIdleCursor" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.HideCursorWhenIdle, Mode=TwoWay}"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Raw Cursor Information Badge -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <TextBlock x:Name="TbRawCursorInfoTitle" Text="Ham Kayıt Fare İmleci" FontSize="12" FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TbRawCursorInfoDesc"
                                        Text="Kayıt esnasında 'Ham Kayıtta Fare İmlecini Gizle' seçildiğinde videodaki orijinal imleç kaydedilmez ve yalnızca burada seçtiğiniz özel imleç görünür."
                                        FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="15"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 2: CANVAS SIZE & STYLE ==================== -->
                        <StackPanel x:Name="PanelTabCanvas" Spacing="14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE799;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbTitleCanvas" Text="CANVAS SIZE &amp; STYLE" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                    Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Aspect Ratio Buttons -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="TbAspectRatio" Text="Aspect Ratio" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnRatioOrig" Grid.Column="0" Content="Auto" FontSize="10"
                                            Click="OnCanvasRatioSelected" Tag="Original" HorizontalAlignment="Stretch" CornerRadius="6" Padding="0,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnRatio169" Grid.Column="1" Content="16:9" FontSize="10"
                                            Click="OnCanvasRatioSelected" Tag="16:9" HorizontalAlignment="Stretch" CornerRadius="6" Padding="0,6"
                                            Background="#26C0C1FF" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <Button x:Name="BtnRatio11" Grid.Column="2" Content="1:1" FontSize="10"
                                            Click="OnCanvasRatioSelected" Tag="1:1" HorizontalAlignment="Stretch" CornerRadius="6" Padding="0,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnRatio43" Grid.Column="3" Content="4:3" FontSize="10"
                                            Click="OnCanvasRatioSelected" Tag="4:3" HorizontalAlignment="Stretch" CornerRadius="6" Padding="0,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnRatio916" Grid.Column="4" Content="9:16" FontSize="10"
                                            Click="OnCanvasRatioSelected" Tag="9:16" HorizontalAlignment="Stretch" CornerRadius="6" Padding="0,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Style Sliders (Padding, Inset, Roundness, Shadow) -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <!-- Video Çerçevesi Toggle -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Video Çerçevesi" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.IsVideoFrameEnabled, Mode=TwoWay}"
                                            Toggled="OnVideoFrameToggled"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>

                                    <!-- Roundness -->
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbRoundnessLabel" Text="Roundness" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbRoundnessVal" Grid.Column="1" Text="4" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider x:Name="SliderRoundness" Minimum="0" Maximum="20" Value="{x:Bind ViewModel.Roundness, Mode=TwoWay}"
                                            ValueChanged="OnRoundnessValueChanged"/>
                                    </StackPanel>

                                    <!-- Shadow -->
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbShadowLabel" Text="Shadow" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbShadowVal" Grid.Column="1" Text="100%" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider x:Name="SliderShadow" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Shadow, Mode=TwoWay}"
                                            ValueChanged="OnShadowValueChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Background Presets & Color Palette -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="TbBgPresetLabel" Text="Background Preset" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>


                                    <!-- Color Swatches Grid -->
                                    <Grid ColumnSpacing="8" RowSpacing="8" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border x:Name="BgBlack" Grid.Row="0" Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                            Background="#0D0E15" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="2"
                                            Tapped="OnBgColorSelected" Tag="Black"/>
                                        <Border Grid.Row="0" Grid.Column="1" Width="26" Height="26" CornerRadius="13"
                                            Background="#1E1F27" BorderBrush="Transparent" BorderThickness="2"
                                            Tapped="OnBgColorSelected" Tag="DarkGray"/>
                                        <Border Grid.Row="0" Grid.Column="2" Width="26" Height="26" CornerRadius="13"
                                            Background="#1E1B4B" BorderBrush="Transparent" BorderThickness="2"
                                            Tapped="OnBgColorSelected" Tag="Purple"/>
                                        <Border Grid.Row="0" Grid.Column="3" Width="26" Height="26" CornerRadius="13"
                                            Background="#0C4A6E" BorderBrush="Transparent" BorderThickness="2"
                                            Tapped="OnBgColorSelected" Tag="Navy"/>
                                        <Border Grid.Row="0" Grid.Column="4" Width="26" Height="26" CornerRadius="13"
                                            Background="#064E3B" BorderBrush="Transparent" BorderThickness="2"
                                            Tapped="OnBgColorSelected" Tag="Emerald"/>
                                        <Border Grid.Row="0" Grid.Column="5" Width="26" Height="26" CornerRadius="13"
                                            Background="#4C0519" BorderBrush="Transparent" BorderThickness="2"
                                            Tapped="OnBgColorSelected" Tag="Crimson"/>

                                        <!-- Row 2: Gradients -->
                                        <Border Grid.Row="1" Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                            BorderBrush="Transparent" BorderThickness="2" Tapped="OnBgColorSelected" Tag="Grad1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#C0C1FF" Offset="0"/>
                                                    <GradientStop Color="#A078FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Width="26" Height="26" CornerRadius="13"
                                            BorderBrush="Transparent" BorderThickness="2" Tapped="OnBgColorSelected" Tag="Grad2">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                                    <GradientStop Color="#9333EA" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="2" Width="26" Height="26" CornerRadius="13"
                                            BorderBrush="Transparent" BorderThickness="2" Tapped="OnBgColorSelected" Tag="Grad3">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#EC4899" Offset="0"/>
                                                    <GradientStop Color="#F43F5E" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="3" Width="26" Height="26" CornerRadius="13"
                                            BorderBrush="Transparent" BorderThickness="2" Tapped="OnBgColorSelected" Tag="Grad4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#10B981" Offset="0"/>
                                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="4" Width="26" Height="26" CornerRadius="13"
                                            BorderBrush="Transparent" BorderThickness="2" Tapped="OnBgColorSelected" Tag="Grad5">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                                    <GradientStop Color="#EF4444" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="5" Width="26" Height="26" CornerRadius="13"
                                            BorderBrush="Transparent" BorderThickness="2" Tapped="OnBgColorSelected" Tag="Grad6">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#6366F1" Offset="0"/>
                                                    <GradientStop Color="#D946EF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>


                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 3: MICROPHONE AUDIO ==================== -->
                        <StackPanel x:Name="PanelTabAudio" Spacing="14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE720;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbTitleAudio" Text="MICROPHONE AUDIO" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                    Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Mute -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TbMuteMic" Text="Mute Microphone" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="TsMicMute" Grid.Column="1"
                                        IsOn="{x:Bind ViewModel.MicMuted, Mode=TwoWay}"
                                        OnContent="" OffContent="" Margin="0"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 4: SHORTCUT KEYS ==================== -->
                        <StackPanel x:Name="PanelTabKeys" Spacing="14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE765;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbTitleKeys" Text="SHORTCUT KEYS" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                    Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Display Toggles -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbDisplayShortcutKeys" Text="Display Shortcut Keys" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsShortcutKeys" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.ShowKeystrokes, Mode=TwoWay}"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbDisplaySingleKey" Text="Display Single Shortcut Key" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsDisplaySingleKey" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.DisplaySingleShortcutKey, Mode=TwoWay}"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Style & Color -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="TbKeyStyle" Text="Key Style" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnKeyStyleFilled" Grid.Column="0" Content="Filled" FontSize="11"
                                            Click="OnKeyStyleSelected" Tag="filled" HorizontalAlignment="Stretch" CornerRadius="6"
                                            Background="#26C0C1FF" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <Button x:Name="BtnKeyStyleOutline" Grid.Column="1" Content="Outline" FontSize="11"
                                            Click="OnKeyStyleSelected" Tag="outline" HorizontalAlignment="Stretch" CornerRadius="6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnKeyStyleMinimal" Grid.Column="2" Content="Minimal" FontSize="11"
                                            Click="OnKeyStyleSelected" Tag="minimal" HorizontalAlignment="Stretch" CornerRadius="6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                    </Grid>

                                    <!-- Size Slider -->
                                    <StackPanel Spacing="4" Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbKeySize" Text="Key Size" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbKeySizeVal" Grid.Column="1" Text="24" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider x:Name="SliderKeySize" Minimum="12" Maximum="48" Value="{x:Bind ViewModel.ShortcutSize, Mode=TwoWay}"
                                            ValueChanged="OnKeySizeChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Position 3x3 Grid -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="TbScreenPos" Text="Screen Position" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Grid HorizontalAlignment="Center" ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>
                                        <Button Click="OnKeyPosSelected" Tag="top-left" Grid.Row="0" Grid.Column="0" Content="TL" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Button Click="OnKeyPosSelected" Tag="top-center" Grid.Row="0" Grid.Column="1" Content="TC" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Button Click="OnKeyPosSelected" Tag="top-right" Grid.Row="0" Grid.Column="2" Content="TR" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Button Click="OnKeyPosSelected" Tag="mid-left" Grid.Row="1" Grid.Column="0" Content="ML" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Button Click="OnKeyPosSelected" Tag="center" Grid.Row="1" Grid.Column="1" Content="C" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Button Click="OnKeyPosSelected" Tag="mid-right" Grid.Row="1" Grid.Column="2" Content="MR" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Button Click="OnKeyPosSelected" Tag="bottom-left" Grid.Row="2" Grid.Column="0" Content="BL" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Button Click="OnKeyPosSelected" Tag="bottom-center" Grid.Row="2" Grid.Column="1" Content="BC" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#26C0C1FF" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <Button Click="OnKeyPosSelected" Tag="bottom-right" Grid.Row="2" Grid.Column="2" Content="BR" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 5: MOTION & BLUR ==================== -->
                        <StackPanel x:Name="PanelTabMotion" Spacing="14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74B;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbTitleMotion" Text="MOTION &amp; BLUR" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                    Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Motion Blur Master Toggle -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TbMotionBlur" Text="Motion Blur" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="TsMotionBlur" Grid.Column="1"
                                        IsOn="{x:Bind ViewModel.MotionBlur, Mode=TwoWay}"
                                        OnContent="" OffContent="" Margin="0"/>
                                </Grid>
                            </Border>

                            <!-- Blur Sliders (Zoom-in, Screen, Cursor) -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <!-- Zoom-in Motion Blur -->
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbZoomBlur" Text="Zoom-in Motion Blur" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbZoomBlurVal" Grid.Column="1" Text="50%" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider x:Name="MotionBlurSlider" Minimum="0" Maximum="100" Value="50"
                                            ValueChanged="OnMotionBlurChanged"/>
                                    </StackPanel>

                                    <!-- Screen Motion Blur -->
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbScreenBlur" Text="Screen Motion Blur" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbScreenBlurVal" Grid.Column="1" Text="50%" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ScreenMotionBlurAmount, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <!-- Cursor Motion Blur -->
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbCursorBlur" Text="Cursor Motion Blur" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbCursorBlurVal" Grid.Column="1" Text="50%" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.CursorMotionBlurAmount, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Movement Speed Selectors -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbCursorMovement" Text="Cursor Movement" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsCursorMovement" Grid.Column="1" IsOn="True" OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                    <Grid ColumnSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnSpeedSlow" Grid.Column="0" Style="{StaticResource SpeedButtonStyle}"
                                            Content="Slow" Click="OnSpeedSelected" Tag="Slow" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnSpeedMedium" Grid.Column="1" Style="{StaticResource SpeedButtonStyle}"
                                            Content="Medium" Click="OnSpeedSelected" Tag="Medium" HorizontalAlignment="Stretch"
                                            Background="{StaticResource SurfaceContainerLowestBrush}" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <Button x:Name="BtnSpeedFast" Grid.Column="2" Style="{StaticResource SpeedButtonStyle}"
                                            Content="Fast" Click="OnSpeedSelected" Tag="Fast" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 6: CAMERA ==================== -->
                        <StackPanel x:Name="PanelTabCamera" Spacing="14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE722;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbTitleCamera" Text="CAMERA OVERLAY" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                    Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbCameraLayer" Text="Kamera Katmanı" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsCameraVisible" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.CameraVisible, Mode=TwoWay}"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>

                                    <TextBlock x:Name="TbCameraShape" Text="Kamera Şekli" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnCamCircle" Grid.Column="0" Content="Daire" FontSize="11"
                                            Click="OnCameraShapeSelected" Tag="circle" HorizontalAlignment="Stretch" CornerRadius="6"
                                            Background="#26C0C1FF" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <Button x:Name="BtnCamSquare" Grid.Column="1" Content="Kare" FontSize="11"
                                            Click="OnCameraShapeSelected" Tag="square" HorizontalAlignment="Stretch" CornerRadius="6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnCamRounded" Grid.Column="2" Content="Yuvarlak" FontSize="11"
                                            Click="OnCameraShapeSelected" Tag="rounded" HorizontalAlignment="Stretch" CornerRadius="6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 7: VOLUME MIXER ==================== -->
                        <StackPanel x:Name="PanelTabVolume" Spacing="14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE767;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbTitleVolume" Text="AUDIO MIXER" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                    Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <!-- Mic Volume -->
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbMicLevel2" Text="Mikrofon Seviyesi" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbMicVolVal2" Grid.Column="1" Text="100%" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.MicVolume, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <!-- System Volume -->
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbSysLevel" Text="Sistem Sesi Seviyesi" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbSysVolVal" Grid.Column="1" Text="100%" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider x:Name="SysVolumeSlider" Minimum="0" Maximum="100" Value="100"
                                            ValueChanged="OnSysVolumeChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 8: WATERMARK ==================== -->
                        <StackPanel x:Name="PanelTabWatermark" Spacing="14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE734;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbTitleWatermark" Text="WATERMARK" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                    Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbWatermarkShow" Text="Filigran Göster" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsWatermark" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.Watermark, Mode=TwoWay}"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                    <TextBox x:Name="TbWatermarkText"
                                        Text="{x:Bind ViewModel.WatermarkText, Mode=TwoWay}"
                                        PlaceholderText="Filigran Metni"
                                        FontSize="12" CornerRadius="6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 9: ZOOM PROPERTIES ==================== -->
                        <StackPanel x:Name="PanelTabZoom" Spacing="14" Visibility="Collapsed">
                            <StackPanel x:Name="ZoomPropertiesPanel" Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71E;" FontSize="16" Foreground="{StaticResource TertiaryBrush}"/>
                                        <TextBlock x:Name="TbTitleZoomProps" Text="ZOOM SETTINGS" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                            Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Global Dynamic Zoom Settings -->
                                <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="14"
                                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="14">
                                        
                                        <!-- Easing Function -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Animasyon Eğrisi (Easing)" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <ComboBox x:Name="CbZoomEasing" SelectedItem="{x:Bind ViewModel.ZoomEasingFunction, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{StaticResource SurfaceContainerLowestBrush}">
                                                <x:String>Linear</x:String>
                                                <x:String>Quad-Out</x:String>
                                                <x:String>Cubic-Out</x:String>
                                                <x:String>Quartic-Out</x:String>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Zoom Speed (Duration) ms -->
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Yakınlaştırma Hızı" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{x:Bind ViewModel.ZoomSpeedMs, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Grid.Column="1"/>
                                            </Grid>
                                            <Slider x:Name="SliderZoomSpeed" Maximum="1500" Minimum="200" Value="{x:Bind ViewModel.ZoomSpeedMs, Mode=TwoWay}" StepFrequency="50"/>
                                        </StackPanel>

                                        <!-- Zoom Hold Duration s -->
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Odakta Kalma Süresi (sn)" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{x:Bind ViewModel.ZoomHoldDurationSec, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Grid.Column="1"/>
                                            </Grid>
                                            <Slider x:Name="SliderZoomHoldDuration" Maximum="10.0" Minimum="0.5" Value="{x:Bind ViewModel.ZoomHoldDurationSec, Mode=TwoWay}" StepFrequency="0.5"/>
                                        </StackPanel>

                                        <!-- Max Scale -->
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Maksimum Büyütme" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{x:Bind ViewModel.ZoomMaxScale, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Grid.Column="1"/>
                                            </Grid>
                                            <Slider x:Name="SliderZoomMaxScale" Maximum="2.2" Minimum="1.0" Value="{x:Bind ViewModel.ZoomMaxScale, Mode=TwoWay}" StepFrequency="0.1"/>
                                        </StackPanel>

                                        <!-- Pre-Click Anticipation -->
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tıklama Öncesi Odak (ms)" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{x:Bind ViewModel.PreClickAnticipationMs, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Grid.Column="1"/>
                                            </Grid>
                                            <Slider Maximum="1000" Minimum="0" Value="{x:Bind ViewModel.PreClickAnticipationMs, Mode=TwoWay}" StepFrequency="50"/>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71E;" FontSize="16" Foreground="{StaticResource TertiaryBrush}"/>
                                        <TextBlock Text="SEÇİLİ ZOOM" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                            Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="4"
                                        Click="OnDeleteZoomClicked">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource ErrorBrush}"/>
                                    </Button>
                                </Grid>
                                <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="14"
                                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="14">
                                        <!-- Zoom Factor -->
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TbZoomFactor" Text="Zoom Factor" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Border Grid.Column="1" Background="{StaticResource PrimaryGlowBrush}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock x:Name="TbSelectedZoomFactor" Text="{x:Bind ViewModel.SelectedZoomScale, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                                        Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                </Border>
                                            </Grid>
                                            <Slider x:Name="SelectedZoomSlider" Maximum="2.2" Minimum="1.0" Value="{x:Bind ViewModel.SelectedZoomScale, Mode=TwoWay}" StepFrequency="0.1"/>
                                        </StackPanel>

                                        <!-- Start / End Sec -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock x:Name="TbZoomStart" Text="Start (sec)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                <NumberBox x:Name="NbZoomStart" Minimum="0" SmallChange="0.1"
                                                    BorderBrush="{StaticResource GlassBorderBrush}"
                                                    Background="{StaticResource SurfaceContainerLowestBrush}"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    ValueChanged="OnZoomStartChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock x:Name="TbZoomEnd" Text="End (sec)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                <NumberBox x:Name="NbZoomEnd" Minimum="0" SmallChange="0.1"
                                                    BorderBrush="{StaticResource GlassBorderBrush}"
                                                    Background="{StaticResource SurfaceContainerLowestBrush}"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    ValueChanged="OnZoomEndChanged"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Easing Preset ComboBox -->
                                        <StackPanel Spacing="6" Margin="0,4,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Animasyon Eğrisi (Easing)" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="TbBezierPresetName" Text="Cubic-Out" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Grid.Column="1"/>
                                            </Grid>
                                            <ComboBox x:Name="CbSelectedZoomEasing" HorizontalAlignment="Stretch" 
                                                Background="{StaticResource SurfaceContainerLowestBrush}"
                                                SelectedItem="{x:Bind ViewModel.SelectedZoomEasing, Mode=TwoWay}">
                                                <x:String>Linear</x:String>
                                                <x:String>Quad-Out</x:String>
                                                <x:String>Cubic-Out</x:String>
                                                <x:String>Quartic-Out</x:String>
                                                <x:String>Ease-In-Out</x:String>
                                                <x:String>Özel (Custom Eğri)</x:String>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Interactive Bézier Curve Graph -->
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Eğri Düzenleyici (Bézier)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock x:Name="TbBezierCoords" Text="P1: 0.22, 0.61 | P2: 0.36, 1.00" FontSize="10" Foreground="{StaticResource PrimaryAccentBrush}" Grid.Column="1"/>
                                            </Grid>
                                            <Border Background="{StaticResource SurfaceContainerLowestBrush}"
                                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="6" Height="140" HorizontalAlignment="Stretch">
                                                <Canvas x:Name="CanvasBezierGraph" Background="Transparent"
                                                    PointerPressed="OnBezierGraphPointerPressed"
                                                    PointerMoved="OnBezierGraphPointerMoved"
                                                    PointerReleased="OnBezierGraphPointerReleased"
                                                    PointerExited="OnBezierGraphPointerExited">
                                                    <!-- Grid Lines -->
                                                    <Line x:Name="GridLineH1" X1="0" Y1="32" X2="240" Y2="32" Stroke="#22FFFFFF" StrokeDashArray="2,2"/>
                                                    <Line x:Name="GridLineH2" X1="0" Y1="64" X2="240" Y2="64" Stroke="#22FFFFFF" StrokeDashArray="2,2"/>
                                                    <Line x:Name="GridLineH3" X1="0" Y1="96" X2="240" Y2="96" Stroke="#22FFFFFF" StrokeDashArray="2,2"/>
                                                    <Line x:Name="GridLineDiag" X1="10" Y1="118" X2="210" Y2="10" Stroke="#15FFFFFF" StrokeDashArray="3,3"/>
                                                    
                                                    <!-- Handles Lines -->
                                                    <Line x:Name="LineHandleP1" Stroke="#88A855F7" StrokeThickness="1.5"/>
                                                    <Line x:Name="LineHandleP2" Stroke="#8806B6D4" StrokeThickness="1.5"/>
                                                    
                                                    <!-- Bézier Curve Path -->
                                                    <Path x:Name="PathBezierCurve" Stroke="{StaticResource PrimaryAccentBrush}" StrokeThickness="2.5">
                                                        <Path.Data>
                                                            <PathGeometry>
                                                                <PathFigure x:Name="FigBezierCurve" StartPoint="10,118">
                                                                    <BezierSegment x:Name="SegBezierCurve" Point1="50,50" Point2="150,20" Point3="210,10"/>
                                                                </PathFigure>
                                                            </PathGeometry>
                                                        </Path.Data>
                                                    </Path>

                                                    <!-- P1 Handle Thumb -->
                                                    <Border x:Name="ThumbP1" Width="14" Height="14" CornerRadius="7" 
                                                        Background="#A855F7" BorderBrush="#FFFFFF" BorderThickness="2"
                                                        Canvas.Left="43" Canvas.Top="43">
                                                        <ToolTipService.ToolTip>
                                                            <ToolTip Content="Kontrol Noktası 1 (Sürükle)"/>
                                                        </ToolTipService.ToolTip>
                                                    </Border>

                                                    <!-- P2 Handle Thumb -->
                                                    <Border x:Name="ThumbP2" Width="14" Height="14" CornerRadius="7" 
                                                        Background="#06B6D4" BorderBrush="#FFFFFF" BorderThickness="2"
                                                        Canvas.Left="143" Canvas.Top="13">
                                                        <ToolTipService.ToolTip>
                                                            <ToolTip Content="Kontrol Noktası 2 (Sürükle)"/>
                                                        </ToolTipService.ToolTip>
                                                    </Border>
                                                </Canvas>
                                            </Border>
                                        </StackPanel>

                                        <!-- Real-Time Zoom Preview -->
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Canlı Zoom Önizleme" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                <Border Background="#2A10B981" CornerRadius="4" Padding="6,1" Grid.Column="1">
                                                    <TextBlock x:Name="TbLivePreviewStatus" Text="CANLI" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                                </Border>
                                            </Grid>
                                            <Border x:Name="PreviewContainerBorder" Background="#0A0B10" BorderBrush="{StaticResource GlassBorderBrush}" 
                                                BorderThickness="1" CornerRadius="8" Height="90" SizeChanged="OnPreviewContainerSizeChanged">
                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <!-- Mini Screen Display Content -->
                                                    <Grid x:Name="PreviewTargetBox" HorizontalAlignment="Center" VerticalAlignment="Center" Width="80" Height="48" RenderTransformOrigin="0.5,0.5">
                                                        <Border Background="#1C1D28" CornerRadius="6" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                            <Grid Padding="6">
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                                                    <FontIcon Glyph="&#xE71E;" FontSize="14" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                                    <TextBlock Text="Zoom Hedefi" FontSize="8.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                    
                                                    <!-- Speed / Scale badge overlay -->
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" 
                                                        Background="#99000000" CornerRadius="4" Padding="6,2">
                                                        <TextBlock x:Name="TbPreviewScaleIndicator" Text="1.0x" FontSize="10" 
                                                            FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <!-- Apply to Selected Zooms Button -->
                                        <Button x:Name="BtnApplyToSelectedZooms" HorizontalAlignment="Stretch"
                                            Background="#26C0C1FF" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="10,8" Margin="0,6,0,0"
                                            Click="OnApplyToSelectedZoomsClicked">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE8D7;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                <TextBlock Text="Seçili Zoomlara Uygula" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Apply to All Button -->
                                        <Button x:Name="BtnApplyZoomToAll" HorizontalAlignment="Stretch"
                                            Background="{StaticResource SurfaceContainerLowestBrush}"
                                            BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="10,8" Margin="0,4,0,0"
                                            Click="OnApplyZoomToAllClicked">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                <TextBlock Text="Tüm Zoomlara Uygula" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 2: VIDEO CANVAS (CENTER) -->
            <Border Grid.Column="2"
                Margin="16"
                Background="#0D0E15"
                CornerRadius="12"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1">
                <Grid x:Name="VideoCanvasHost" SizeChanged="OnVideoCanvasHostSizeChanged">
                    <!-- Radial glow background -->
                    <Ellipse Width="600" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1AC0C1FF" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- 16:9 Video container -->
                    <Border x:Name="VideoContainer"
                            CornerRadius="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <!-- Layer 0: Dynamic Background -->
                            <Border x:Name="PreviewBackgroundLayer"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1E2A4A" Offset="0"/>
                                        <GradientStop Color="#0F172A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Image x:Name="PreviewBackgroundImage"
                                   Stretch="UniformToFill" Visibility="Collapsed"/>

                            <!-- Zoom Transform Grid -->
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="VideoTransform"
                                        ScaleX="1.0" ScaleY="1.0"
                                        TranslateX="0" TranslateY="0"/>
                                </Grid.RenderTransform>

                                <!-- Layer 1: Scaled Video Window -->
                                <Border x:Name="VideoWindowLayer" Translation="0,0,32">
                                    <Border.Shadow>
                                        <ThemeShadow />
                                    </Border.Shadow>
                                    <MediaPlayerElement x:Name="VideoPlayer"
                                        AutoPlay="False" AreTransportControlsEnabled="False"
                                        Stretch="Uniform" MinHeight="200"/>
                                </Border>

                                <!-- Layer 2: Black Gap Overlay -->
                                <Border x:Name="BlackGapOverlay"
                                        Background="#000000"
                                        Visibility="Collapsed" IsHitTestVisible="False"/>

                                <!-- Layer 3: Cursor Overlay -->
                                <Canvas x:Name="CursorOverlayCanvas"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                    <Canvas.RenderTransform>
                                        <CompositeTransform x:Name="CursorCanvasTransform" ScaleX="1.0" ScaleY="1.0" TranslateX="0" TranslateY="0"/>
                                    </Canvas.RenderTransform>
                                </Canvas>

                                <!-- Layer 4: UI Overlays -->
                                <Button x:Name="VideoClickOverlay"
                                        Background="Transparent" BorderThickness="0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Click="OnVideoCanvasClicked"/>

                                <Border x:Name="PlayOverlay"
                                        Background="#660D0E15"
                                        CornerRadius="10"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Opacity="1"
                                        IsHitTestVisible="False">
                                    <Border Width="64" Height="64" CornerRadius="32"
                                            Background="#33C0C1FF"
                                            BorderBrush="#80C0C1FF" BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon x:Name="PlayOverlayIcon"
                                                  Glyph="&#xE768;" FontSize="28"
                                                  Foreground="{StaticResource PrimaryAccentBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Border>

                                <!-- No video file warning message -->
                                <StackPanel x:Name="NoVideoMessage"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Spacing="8" Visibility="Collapsed" IsHitTestVisible="False">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="36" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TbNoVideoMessage" Text="Video Dosyası Yüklenemedi" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TbMissingVideoPath" Text="" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"/>
                                </StackPanel>

                                <!-- Resolution badge top-right -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="12" Background="#990D0E15"
                                        CornerRadius="6" Padding="8,4"
                                        BorderBrush="#1AFFFFFF" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TbResolution" Text="1080p • 60fps"
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Zoom level badge bottom-left -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="12" Background="#990D0E15"
                                        CornerRadius="6" Padding="8,4"
                                        BorderBrush="#1AFFFFFF" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE71E;" FontSize="11"
                                                  Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <TextBlock x:Name="ZoomLevelBadge" Text="1.0x"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        </Grid>

        <!-- ====================================================
             ROW 2: TIMELINE AREA (PROFESSIONAL NLE GRADE)
             ==================================================== -->
        <Border Grid.Row="2"
            Background="{StaticResource SurfaceContainerLowBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Timeline toolbar -->
                    <RowDefinition Height="44"/>
                    <!-- Tracks area -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TIMELINE TOOLBAR -->
                <Border Grid.Row="0"
                    Background="{StaticResource GlassNavBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Edit tools (left) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="BtnUndo" Style="{StaticResource IconButtonStyle}" Click="OnUndoClicked"
                                ToolTipService.ToolTip="Geri Al (Ctrl+Z)">
                                <FontIcon Glyph="&#xE7A7;" FontSize="15"
                                    Foreground="{StaticResource TextMutedBrush}"/>
                            </Button>
                            <Button x:Name="BtnRedo" Style="{StaticResource IconButtonStyle}" Click="OnRedoClicked"
                                ToolTipService.ToolTip="Yinele (Ctrl+Y)">
                                <FontIcon Glyph="&#xE7A6;" FontSize="15"
                                    Foreground="{StaticResource TextMutedBrush}"/>
                            </Button>
                            <Rectangle Width="1" Height="18" Fill="{StaticResource GlassBorderBrush}" Margin="4,0"/>
                            <Button x:Name="BtnSplit" Style="{StaticResource IconButtonStyle}" Click="OnSplitClicked"
                                ToolTipService.ToolTip="Böl / Cut (S)">
                                <FontIcon Glyph="&#xE8C6;" FontSize="15"
                                    Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Button>
                            <Button x:Name="BtnDeleteZoom" Style="{StaticResource IconButtonStyle}" Click="OnDeleteZoomClicked"
                                ToolTipService.ToolTip="Seçili Klibi veya Efekti Sil (Del / Çöp Kutusu)">
                                <FontIcon Glyph="&#xE74D;" FontSize="15"
                                    Foreground="{StaticResource ErrorBrush}"/>
                            </Button>
                        </StackPanel>

                        <!-- Play controls + timecode (center) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center">

                            <Border Background="#660D0E15" CornerRadius="6" Padding="10,4"
                                BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock x:Name="TbTimelineCurrent" Text="00:01:23"
                                        FontSize="13" FontWeight="SemiBold"
                                        FontFamily="Consolas"
                                        Foreground="{StaticResource PrimaryAccentBrush}"/>
                                    <TextBlock Text="/" FontSize="13"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TbTimelineTotal" Text="00:05:00"
                                        FontSize="13" FontFamily="Consolas"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceHighBrush}"
                                CornerRadius="8" Padding="3"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Style="{StaticResource PlayControlStyle}"
                                        Click="OnSkipPrevClicked">
                                        <FontIcon Glyph="&#xE76B;" FontSize="18"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Button>
                                    <Button x:Name="BtnPlayPause"
                                        Style="{StaticResource PlayControlStyle}"
                                        Background="{StaticResource PrimaryAccentBrush}"
                                        Click="OnPlayPauseClicked" CornerRadius="6">
                                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="18"
                                            Foreground="#1000A9"/>
                                    </Button>
                                    <Button Style="{StaticResource PlayControlStyle}"
                                        Click="OnSkipNextClicked">
                                        <FontIcon Glyph="&#xE76C;" FontSize="18"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Button>
                                    <Rectangle Width="1" Height="20" Fill="{StaticResource GlassBorderBrush}" Margin="4,0"/>
                                    
                                    <!-- Dynamic Audio Volume Flyout Button -->
                                    <Button x:Name="BtnMuteAudio" Style="{StaticResource PlayControlStyle}"
                                        ToolTipService.ToolTip="Ses Seviyesi ve Ayarları">
                                        <Button.Flyout>
                                            <Flyout x:Name="VolumeFlyout" Placement="Top">
                                                <Border Background="#1E1F2A" CornerRadius="10" Padding="14,12"
                                                        BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                                        Width="250">
                                                    <StackPanel Spacing="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button x:Name="BtnFlyoutMuteToggle" Click="OnFlyoutMuteToggleClicked"
                                                                    Style="{StaticResource IconButtonStyle}" Width="28" Height="28">
                                                                <FontIcon x:Name="FlyoutMuteIcon" Glyph="&#xE995;" FontSize="15"
                                                                          Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                            </Button>
                                                            <TextBlock Text="Master Ses" FontSize="12" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" Margin="6,0,0,0" Grid.Column="1"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock x:Name="TbVolumePercent" Text="100%" FontSize="12"
                                                                       FontFamily="Consolas" Grid.Column="2"
                                                                       VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                                        </Grid>
                                                        <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="100" Value="100"
                                                                ValueChanged="OnMasterVolumeSliderChanged"
                                                                HorizontalAlignment="Stretch"/>
                                                    </StackPanel>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <FontIcon x:Name="MuteIcon" Glyph="&#xE995;" FontSize="16"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Zoom slider (right) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                            <FontIcon x:Name="IconZoomOut" Glyph="&#xE71F;" FontSize="13"
                                Foreground="{StaticResource TextMutedBrush}" ToolTipService.ToolTip="Timeline Daralt"/>
                            <Slider x:Name="TimelineZoomSlider"
                                Width="100" Minimum="0" Maximum="100" Value="50"/>
                            <FontIcon x:Name="IconZoomIn" Glyph="&#xE8A3;" FontSize="13"
                                Foreground="{StaticResource TextMutedBrush}" ToolTipService.ToolTip="Timeline Genişlet (Ctrl+Tekerlek)"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TRACKS AREA (Track Headers + Scrollable Canvas Content) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Track headers column -->
                        <ColumnDefinition Width="200"/>
                        <!-- Scrollable timeline content column -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TRACK HEADERS (LEFT 200px) -->
                    <Border Grid.Column="0"
                        Background="{StaticResource SurfaceContainerBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="0,0,1,0">
                        <StackPanel>
                            <!-- Time ruler spacer (22px) -->
                            <Border Height="22"
                                Background="{StaticResource SurfaceContainerLowestBrush}"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="0,0,0,1"/>

                            <!-- Video track header (72px) -->
                            <Border Height="72"
                                Background="Transparent"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE714;" FontSize="16"
                                            Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TbTrackVideo" Text="Video Track" FontSize="12" FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbTrackVideoSub" Text="Screen Recording" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <!-- Mini video ses seviyesi slider -->
                                        <Slider x:Name="SliderVideoTrackVol" Width="52" Minimum="0" Maximum="100"
                                            Value="{x:Bind ViewModel.SysVolume, Mode=TwoWay}"
                                            ValueChanged="OnVideoTrackVolumeChanged"
                                            ToolTipService.ToolTip="Video Ses Seviyesi"
                                            Margin="0,0,2,0"/>
                                        <Button x:Name="BtnVideoMute" Click="OnVideoTrackMuteClicked" PointerWheelChanged="OnVideoTrackBtnWheelChanged"
                                            Style="{StaticResource IconButtonStyle}" Width="32" Height="26"
                                            ToolTipService.ToolTip="Video Sesini Kapat/Aç (Sağ Tık: Seviye Ayarı)">
                                            <Button.ContextFlyout>
                                                <Flyout Placement="Top" Opened="OnVideoFlyoutOpened">
                                                    <Border Background="{StaticResource SurfaceHighBrush}" Padding="12" CornerRadius="10" Width="190"
                                                        BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                                        <StackPanel Spacing="8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Video Sesi" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Tag="FlyoutVideoVolLabel" Grid.Column="1" Text="100%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <Slider Tag="FlyoutVideoVolSlider" Minimum="0" Maximum="100" Value="100"
                                                                ValueChanged="OnFlyoutVideoVolSliderChanged"/>
                                                            <Button Content="Sesi Kapat / Aç" HorizontalAlignment="Stretch" FontSize="11" Padding="4,4"
                                                                Click="OnVideoTrackMuteClicked"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.ContextFlyout>
                                            <Grid Width="26" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <FontIcon x:Name="IconVideoMute" Glyph="&#xE767;" FontSize="11"
                                                    Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <!-- Animated Sound Wave / Equalizer Bars -->
                                                <StackPanel Orientation="Horizontal" Spacing="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0">
                                                    <Border x:Name="VideoAudioBar1" Width="2" Height="4" CornerRadius="1" VerticalAlignment="Bottom">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                <GradientStop Color="#10B981" Offset="0"/>
                                                                <GradientStop Color="#00D2FF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Border x:Name="VideoAudioBar2" Width="2" Height="8" CornerRadius="1" VerticalAlignment="Bottom">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                <GradientStop Color="#10B981" Offset="0"/>
                                                                <GradientStop Color="#00D2FF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Border x:Name="VideoAudioBar3" Width="2" Height="5" CornerRadius="1" VerticalAlignment="Bottom">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                <GradientStop Color="#10B981" Offset="0"/>
                                                                <GradientStop Color="#00D2FF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Audio track header (56px) -->
                            <Border Height="56"
                                Background="Transparent"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE720;" FontSize="16"
                                            Foreground="#22C55E"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TbTrackAudio" Text="Audio Track" FontSize="12" FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbTrackAudioSub" Text="Waveform / Mic" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <!-- Mini ses seviyesi slider (timeline sol paneli) -->
                                        <Slider x:Name="SliderAudioTrackVol" Width="52" Minimum="0" Maximum="100"
                                            Value="{x:Bind ViewModel.MicVolume, Mode=TwoWay}"
                                            ValueChanged="OnAudioTrackVolumeChanged"
                                            ToolTipService.ToolTip="Mikrofon Ses Seviyesi"
                                            Margin="0,0,2,0"/>
                                        <!-- Sağ tıkla flyout açılır; x:Bind/x:Name flyout içinde WinUI 3'te crash yapıyor,
                                             bu nedenle Opened event ile kod tarafında doldurulur -->
                                        <Button x:Name="BtnAudioMute" Click="OnAudioTrackMuteClicked" PointerWheelChanged="OnAudioTrackBtnWheelChanged"
                                            Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                            ToolTipService.ToolTip="Ses Parçasını Kapat/Aç (Sağ Tık: Seviye Ayarı)">
                                            <Button.ContextFlyout>
                                                <Flyout Placement="Top" Opened="OnAudioFlyoutOpened">
                                                    <Border Background="{StaticResource SurfaceHighBrush}" Padding="12" CornerRadius="10" Width="190"
                                                        BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                                        <StackPanel Spacing="8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Mikrofon Sesi" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                <!-- Yüzde etiketi kod tarafında güncellenir -->
                                                                <TextBlock Tag="FlyoutVolLabel" Grid.Column="1" Text="100%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <!-- x:Bind yerine ValueChanged event ile kod tarafında güncellenir -->
                                                            <Slider Tag="FlyoutVolSlider" Minimum="0" Maximum="100" Value="100"
                                                                ValueChanged="OnFlyoutAudioVolSliderChanged"/>
                                                            <Button Content="Sesi Kapat / Aç" HorizontalAlignment="Stretch" FontSize="11" Padding="4,4"
                                                                Click="OnAudioTrackMuteClicked"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.ContextFlyout>
                                            <FontIcon x:Name="IconAudioMute" Glyph="&#xE767;" FontSize="12"
                                                Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Zoom effects track header (56px) -->
                            <Border Height="56"
                                Background="Transparent"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A3;" FontSize="16"
                                            Foreground="{StaticResource TertiaryBrush}"/>
                                        <TextBlock x:Name="TbTrackZoom" Text="Zoom Effects" FontSize="12" FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Click sound track header (48px) -->
                            <Border x:Name="ClickTrackContainer" Height="48"
                                Background="Transparent"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,0"
                                Visibility="Collapsed">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE962;" FontSize="15"
                                            Foreground="#00D2FF"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TbTrackClick" Text="Fare Tıklama Sesleri" FontSize="12" FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbTrackClickSub" Text="Bilgisayar Tık 02" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button x:Name="BtnToggleClickLane" Click="OnToggleClickLaneClicked"
                                            Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                            ToolTipService.ToolTip="Tıklama kanalını gizle/göster" Margin="0,0,2,0">
                                            <FontIcon x:Name="IconToggleClickLane" Glyph="&#xE712;" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                        <!-- Mini ses seviyesi slider (timeline sol paneli) -->
                                        <Slider x:Name="SliderClickTrackVol" Width="52" Minimum="0" Maximum="100"
                                            Value="{x:Bind ViewModel.CursorClickVolume, Mode=TwoWay}"
                                            ValueChanged="OnClickTrackVolumeChanged"
                                            ToolTipService.ToolTip="Tıklama Ses Seviyesi"
                                            Margin="0,0,2,0"/>
                                        <Button x:Name="BtnClickMute" Click="OnClickTrackMuteClicked" PointerWheelChanged="OnClickTrackBtnWheelChanged"
                                            Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                            ToolTipService.ToolTip="Tıklama Sesini Aç/Kapat (Sağ Tık: Ses Seçimi ve Ayarlar)">
                                            <Button.ContextFlyout>
                                                <Flyout Placement="Top" Opened="OnClickFlyoutOpened">
                                                    <Border Background="{StaticResource SurfaceHighBrush}" Padding="12" CornerRadius="10" Width="220"
                                                        BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                                        <StackPanel Spacing="8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Tıklama Sesi" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Tag="FlyoutClickVolLabel" Grid.Column="1" Text="80%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <Slider Tag="FlyoutClickVolSlider" Minimum="0" Maximum="100" Value="80"
                                                                ValueChanged="OnFlyoutClickVolSliderChanged"/>
                                                            <TextBlock Text="Ses Dosyası:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                            <ComboBox Tag="FlyoutClickSoundCombo" HorizontalAlignment="Stretch" FontSize="11"
                                                                SelectionChanged="OnFlyoutClickSoundSelectionChanged"/>
                                                            <Button Tag="FlyoutClickTestBtn" Content="🔊 Sesi Dinle" HorizontalAlignment="Stretch" FontSize="11" Padding="4,4"
                                                                Click="OnTestClickSoundClicked"/>
                                                            <Button Content="Sesi Kapat / Aç" HorizontalAlignment="Stretch" FontSize="11" Padding="4,4"
                                                                Click="OnClickTrackMuteClicked"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.ContextFlyout>
                                            <FontIcon x:Name="IconClickMute" Glyph="&#xE767;" FontSize="12"
                                                Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- SCROLLABLE TIMELINE CONTENT -->
                    <ScrollViewer Grid.Column="1"
                        x:Name="TimelineScrollViewer"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="TimelineContentGrid" MinWidth="800"
                              Background="Transparent"
                              Margin="8,0,0,0"
                              PointerPressed="OnHoverScrubPointerPressed"
                              PointerMoved="OnHoverScrubPointerMoved"
                              PointerReleased="OnHoverScrubPointerReleased"
                              PointerExited="OnHoverScrubPointerExited">
                            <Grid.RowDefinitions>
                                <!-- Time ruler -->
                                <RowDefinition Height="22"/>
                                <!-- Video track -->
                                <RowDefinition Height="72"/>
                                <!-- Audio track -->
                                <RowDefinition Height="56"/>
                                <!-- Zoom track -->
                                <RowDefinition Height="56"/>
                                <!-- Click sound track -->
                                <RowDefinition Height="0"/>
                            </Grid.RowDefinitions>

                            <!-- TIME RULER (Row 0) -->
                            <Canvas Grid.Row="0"
                                HorizontalAlignment="Left"
                                x:Name="TimeRuler"
                                Background="{StaticResource SurfaceContainerLowestBrush}"
                                Height="22">
                                <!-- Ruler ticks are generated in code-behind -->
                            </Canvas>

                            <!-- VIDEO TRACK (Row 1) -->
                            <Canvas Grid.Row="1"
                                HorizontalAlignment="Left"
                                x:Name="VideoTrack"
                                Background="#080D0E15"
                                PointerEntered="OnVideoTrackPointerEntered">
                                <!-- Base clip block (fallback/rendered in code-behind) -->
                                <Border
                                    x:Name="VideoClipBlock"
                                    Height="56"
                                    Background="{StaticResource VideoTrackBgBrush}"
                                    BorderBrush="{StaticResource VideoTrackBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Canvas.Left="0"
                                    Canvas.Top="8">
                                    <TextBlock Text="recording.mp4" FontSize="11" FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryAccentBrush}"
                                        Margin="4,4,0,0" VerticalAlignment="Top"/>
                                </Border>
                            </Canvas>

                            <!-- AUDIO TRACK (Row 2: Waveform Canvas) -->
                            <Canvas Grid.Row="2"
                                HorizontalAlignment="Left"
                                x:Name="AudioTrack"
                                Background="#0500FF88"
                                PointerEntered="OnAudioTrackPointerEntered">
                                <!-- Waveform bars and audio clips are drawn dynamically in code-behind -->
                            </Canvas>

                            <!-- ZOOM EFFECTS TRACK (Row 3) -->
                            <Canvas Grid.Row="3"
                                HorizontalAlignment="Left"
                                x:Name="ZoomTrack"
                                Background="#030D0E15"
                                PointerEntered="OnZoomTrackPointerEntered"
                                PointerExited="OnZoomTrackPointerExited"
                                PointerMoved="OnZoomTrackPointerMoved"
                                PointerPressed="OnZoomTrackPointerPressed"
                                DoubleTapped="OnZoomTrackDoubleTapped">
                                <!-- Zoom pills are added dynamically in code-behind -->
                                <Border x:Name="ZoomHoverAddBadge"
                                        Canvas.Left="0" Canvas.Top="14"
                                        Background="#33C0C1FF"
                                        BorderBrush="#80C0C1FF" BorderThickness="1"
                                        CornerRadius="8" Padding="8,4"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="#C0C1FF"/>
                                        <TextBlock Text="Zoom Ekle" FontSize="10" Foreground="#C0C1FF"/>
                                    </StackPanel>
                                </Border>
                            </Canvas>

                            <!-- CLICK SOUND TRACK (Row 4) -->
                            <Canvas Grid.Row="4"
                                HorizontalAlignment="Left"
                                x:Name="ClickTrack"
                                Background="#0400D2FF"
                                PointerEntered="OnClickTrackPointerEntered"
                                PointerPressed="OnClickTrackPointerPressed"
                                Visibility="Collapsed">
                                <!-- Click sound markers are added dynamically in code-behind -->
                            </Canvas>

                            <!-- PLAYHEAD (spans all 4 rows, rendered on top) -->
                            <Canvas Grid.Row="0" Grid.RowSpan="4"
                                HorizontalAlignment="Left"
                                IsHitTestVisible="True" ZIndex="100">
                                <Rectangle
                                    x:Name="HoverPlayheadLine"
                                    Width="1"
                                    Height="206"
                                    Fill="White"
                                    Opacity="0.5"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"
                                    Canvas.Left="0"
                                    Canvas.Top="0"/>
                                <Polygon
                                    x:Name="HoverPlayheadTriangle"
                                    Fill="White"
                                    Opacity="0.5"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"
                                    Points="-5,0 5,0 0,8"
                                    Canvas.Left="0"
                                    Canvas.Top="0"/>
                                
                                <Canvas x:Name="PlayheadContainer"
                                        Canvas.Left="190" Canvas.Top="0"
                                        Width="20" Height="206"
                                        Background="Transparent"
                                        PointerPressed="OnPlayheadPointerPressed"
                                        PointerMoved="OnPlayheadPointerMoved"
                                        PointerReleased="OnPlayheadPointerReleased"
                                        PointerExited="OnPlayheadPointerExited"
                                        PointerCanceled="OnPlayheadPointerReleased">
                                    <Rectangle
                                        x:Name="PlayheadLine"
                                        Width="2"
                                        Height="206"
                                        Fill="{StaticResource SecondaryBrush}"
                                        Canvas.Left="9"
                                        Canvas.Top="0"
                                        IsHitTestVisible="False"/>
                                    <Polygon
                                        x:Name="PlayheadTriangle"
                                        Fill="{StaticResource SecondaryBrush}"
                                        Points="-7,0 7,0 0,12"
                                        Canvas.Left="10"
                                        Canvas.Top="0"
                                        IsHitTestVisible="False"/>
                                </Canvas>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
            </Grid>
        </Grid>
        </Border>

        <!-- ====================================================
             EXPORT SETTINGS MODAL / POPUP DIALOG
             ==================================================== -->
        <Grid x:Name="ExportModalOverlay"
              Grid.Row="0" Grid.RowSpan="3"
              Visibility="Collapsed"
              Background="#B3090A10"
              Canvas.ZIndex="1000">

            <!-- Backdrop click dismiss -->
            <Border Background="Transparent" Tapped="OnExportBackdropTapped" />

            <!-- Dialog Container (Modern Dark Glassmorphism) -->
            <Border Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1E1F2A"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="26,22">

                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#26A078FF" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE898;" FontSize="16" Foreground="#C0C1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="TbExportModalTitle" Text="Dışa Aktarma Ayarları"
                                           FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TbExportModalSubtitle" Text="Çözünürlük, kare hızı ve kayıt yerini belirleyin."
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Click="OnCloseExportDialogClicked"
                                Background="Transparent" BorderThickness="0" CornerRadius="8" Width="32" Height="32" Padding="0">
                            <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>
                    </Grid>

                    <Rectangle Height="1" Fill="#1AFFFFFF" />

                    <!-- Resolution (Çözünürlük) -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE790;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock x:Name="TbExportResLabel" Text="Çözünürlük" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <ComboBox x:Name="CmbExportResolution" HorizontalAlignment="Stretch" CornerRadius="8"
                                  Background="#14151E" BorderBrush="#26FFFFFF" SelectionChanged="OnExportSettingChanged">
                            <ComboBoxItem x:Name="ExportRes4K" Tag="4K" Content="4K Ultra HD (3840 × 2160)" />
                            <ComboBoxItem x:Name="ExportRes2K" Tag="2K" Content="2K Quad HD (2560 × 1440)" />
                            <ComboBoxItem x:Name="ExportRes1080p" Tag="1080p" Content="1080p Full HD (1920 × 1080)" IsSelected="True" />
                            <ComboBoxItem x:Name="ExportRes720p" Tag="720p" Content="720p HD (1280 × 720)" />
                        </ComboBox>
                        <TextBlock x:Name="TbExportResInfo" Text="Orijinal kayıttan yüksek çözünürlükler (kaliteyi artırmayacağı için) devre dışı bırakılmıştır."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Frame Rate & Format (Grid with 2 columns) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- FPS -->
                        <StackPanel Grid.Column="0" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbExportFpsLabel" Text="Kare Hızı (FPS)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbExportFps" HorizontalAlignment="Stretch" CornerRadius="8"
                                      Background="#14151E" BorderBrush="#26FFFFFF" SelectionChanged="OnExportSettingChanged">
                                <ComboBoxItem Tag="60" Content="60 FPS (Akıcı)" IsSelected="True" />
                                <ComboBoxItem Tag="30" Content="30 FPS (Standart)" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Format -->
                        <StackPanel Grid.Column="1" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B9;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbExportFormatLabel" Text="Format" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbExportFormat" HorizontalAlignment="Stretch" CornerRadius="8"
                                      Background="#14151E" BorderBrush="#26FFFFFF" IsEnabled="False" SelectedIndex="0">
                                <ComboBoxItem Content="MP4 (H.264 / AAC)" IsSelected="True" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Save Location (Kayıt Yeri) -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED25;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock x:Name="TbExportLocationLabel" Text="Kayıt Konumu" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtExportPath"
                                     Grid.Column="0"
                                     CornerRadius="8"
                                     FontSize="12"
                                     Background="#14151E"
                                     BorderBrush="#26FFFFFF"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Padding="10,7" />
                            <Button x:Name="BtnBrowseExportPath"
                                    Grid.Column="1"
                                    Click="OnBrowseExportPathClicked"
                                    CornerRadius="8"
                                    Padding="14,7"
                                    Background="{StaticResource SurfaceHighBrush}"
                                    BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TbBtnBrowseText" Text="Gözat..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Summary Info Badge -->
                    <Border Background="#14151E" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,7">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock x:Name="TbExportSummaryBadge" Text="1920×1080 • 60 FPS • MP4 Video"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnCancelExportModal"
                                Grid.Column="0"
                                Click="OnCloseExportDialogClicked"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="#26FFFFFF"
                                CornerRadius="8"
                                Padding="16,7">
                            <TextBlock x:Name="TbBtnCancelExportText" Text="İptal" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>

                        <Button x:Name="BtnConfirmExport"
                                Grid.Column="1"
                                Click="OnConfirmExportClicked"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="20,8">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#C0C1FF" Offset="0.0"/>
                                    <GradientStop Color="#A078FF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE898;" FontSize="13" Foreground="#1000A9"/>
                                <TextBlock x:Name="TbBtnConfirmExportText" Text="Dışa Aktar" FontSize="13" FontWeight="Bold" Foreground="#1000A9"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
