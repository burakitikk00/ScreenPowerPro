<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenPowerPro.Views.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ScreenPowerPro.Models"
    mc:Ignorable="d"
    IsTabStop="True"
    KeyDown="OnPageKeyDown"
    Background="{StaticResource SurfaceContainerLowestBrush}">

    <Page.Resources>
        <!-- Small icon button style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SpeedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="PlayControlStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Nav Bar -->
            <RowDefinition Height="48" />
            <!-- Main workspace: video + properties -->
            <RowDefinition Height="*" />
            <!-- Timeline -->
            <RowDefinition Height="260" />
        </Grid.RowDefinitions>

        <!-- ====================================================
             ROW 0: TOP NAV BAR
             ==================================================== -->
        <Border Grid.Row="0"
            Background="{StaticResource GlassNavBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Padding="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>

                <!-- Left: Back + project name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Click="OnBackClicked"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="6" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="Recorder" FontSize="13"
                                Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="16" Fill="{StaticResource GlassBorderBrush}"/>
                    <FontIcon Glyph="&#xE8D2;" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="TbProjectName" Text="Untitled Recording.mp4"
                        FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                        VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: timecode badge & drag area -->
                <Border x:Name="TitleBarDragArea" Grid.Column="1" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center"
                        Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="#660D0E15" CornerRadius="6" Padding="10,4"
                            BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="TbCurrentTime" Text="00:00:00"
                                    FontSize="13" FontWeight="SemiBold"
                                    FontFamily="Consolas"
                                    Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="/" FontSize="13"
                                    Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TbTotalTime" Text="00:00:00"
                                    FontSize="13" FontFamily="Consolas"
                                    Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right: Save + Export -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="BtnSave" Click="OnSaveClicked"
                        Background="{StaticResource SurfaceHighBrush}"
                        BorderThickness="0" CornerRadius="8" Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Save" FontSize="13" FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnExport" Click="OnExportClicked"
                        BorderThickness="0" CornerRadius="8" Padding="18,7">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#C0C1FF" Offset="0.0"/>
                                <GradientStop Color="#A078FF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE898;" FontSize="13" Foreground="#1000A9"/>
                            <TextBlock Text="Export" FontSize="13" FontWeight="Bold" Foreground="#1000A9"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Far Right: Space reserved for Window Caption Buttons -->
                <Border Grid.Column="3" Width="140" Background="Transparent" />
            </Grid>
        </Border>

        <!-- ====================================================
             ROW 1: MAIN WORKSPACE — VIDEO CANVAS + PROPERTIES
             ==================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- VIDEO CANVAS -->
            <Border Grid.Column="0"
                Margin="20,16,12,16"
                Background="#0D0E15"
                CornerRadius="12"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1">
                <Grid>
                    <!-- Radial glow -->
                    <Ellipse Width="600" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1AC0C1FF" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- 16:9 Video container -->
                    <Border
                        x:Name="VideoContainer"
                        MaxWidth="880"
                        CornerRadius="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="32">
                        <Border.Background>
                            <SolidColorBrush Color="#000000"/>
                        </Border.Background>

                        <Grid>
                            <!-- MediaPlayer with live zoom simulation transform -->
                            <MediaPlayerElement
                                x:Name="VideoPlayer"
                                AutoPlay="False"
                                AreTransportControlsEnabled="False"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MinHeight="200"
                                RenderTransformOrigin="0.5,0.5">
                                <MediaPlayerElement.RenderTransform>
                                    <CompositeTransform x:Name="VideoTransform" ScaleX="1.0" ScaleY="1.0" TranslateX="0" TranslateY="0"/>
                                </MediaPlayerElement.RenderTransform>
                            </MediaPlayerElement>

                            <!-- Click overlay for play/pause -->
                            <Button
                                x:Name="VideoClickOverlay"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Click="OnVideoCanvasClicked"/>

                            <!-- Hover play button -->
                            <Border
                                x:Name="PlayOverlay"
                                Background="#660D0E15"
                                CornerRadius="10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Opacity="1"
                                IsHitTestVisible="False">
                                <Border
                                    Width="64" Height="64" CornerRadius="32"
                                    Background="#33C0C1FF"
                                    BorderBrush="#80C0C1FF" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon x:Name="PlayOverlayIcon"
                                        Glyph="&#xE768;" FontSize="28"
                                        Foreground="{StaticResource PrimaryAccentBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>

                            <!-- No video file warning message -->
                            <StackPanel
                                x:Name="NoVideoMessage"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                                <FontIcon Glyph="&#xE7BA;" FontSize="36" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                <TextBlock Text="Video Dosyası Yüklenemedi" FontSize="15" FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TbMissingVideoPath" Text="" FontSize="11"
                                    Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"/>
                            </StackPanel>

                            <!-- Resolution badge top-right -->
                            <Border
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="12"
                                Background="#990D0E15"
                                CornerRadius="6" Padding="8,4"
                                BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TbResolution" Text="1080p • 60fps"
                                        FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Zoom level badge bottom-left -->
                            <Border
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="12"
                                Background="#990D0E15"
                                CornerRadius="6" Padding="8,4"
                                BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71E;" FontSize="11"
                                        Foreground="{StaticResource PrimaryAccentBrush}"/>
                                    <TextBlock x:Name="ZoomLevelBadge" Text="1.0x"
                                        FontSize="11" FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PROPERTIES PANEL -->
            <Border Grid.Column="1"
                Margin="0,16,20,16"
                Background="{StaticResource SurfaceContainerBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel Spacing="24">

                        <!-- SECTION: Cursor & Blur -->
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CURSOR &amp; BLUR"
                                    FontSize="11" FontWeight="Bold"
                                    CharacterSpacing="50"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                    Background="Transparent" BorderThickness="0" Padding="4"
                                    Click="OnAddZoomClicked">
                                    <FontIcon Glyph="&#xE710;" FontSize="14"
                                        Foreground="{StaticResource PrimaryAccentBrush}"/>
                                </Button>
                            </Grid>

                            <Border Background="{StaticResource SurfaceHighBrush}"
                                CornerRadius="10" Padding="14"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <!-- Zoom Level -->
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Zoom Level" FontSize="13"
                                                Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border Grid.Column="1"
                                                Background="{StaticResource PrimaryGlowBrush}"
                                                CornerRadius="4" Padding="6,2">
                                                <TextBlock x:Name="TbZoomLevel" Text="150%"
                                                    FontSize="11" FontWeight="SemiBold"
                                                    Foreground="{StaticResource PrimaryAccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Slider x:Name="ZoomLevelSlider"
                                            Minimum="100" Maximum="300" Value="150"
                                            ValueChanged="OnZoomLevelChanged"/>
                                    </StackPanel>

                                    <!-- Motion Blur -->
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Motion Blur" FontSize="13"
                                                Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border Grid.Column="1"
                                                Background="{StaticResource SurfaceHighestBrush}"
                                                CornerRadius="4" Padding="6,2">
                                                <TextBlock x:Name="TbMotionBlur" Text="30%"
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextMutedBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Slider x:Name="MotionBlurSlider"
                                            Minimum="0" Maximum="100" Value="30"
                                            ValueChanged="OnMotionBlurChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- SECTION: Cursor Movement -->
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CURSOR MOVEMENT"
                                    FontSize="11" FontWeight="Bold"
                                    CharacterSpacing="50"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    VerticalAlignment="Center"/>
                                <ToggleSwitch x:Name="TsCursorMovement"
                                    Grid.Column="1" IsOn="True"
                                    OnContent="" OffContent="" Margin="0"/>
                            </Grid>

                            <!-- Speed selector -->
                            <Border Background="{StaticResource SurfaceHighBrush}"
                                CornerRadius="10" Padding="4"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnSpeedSlow" Grid.Column="0"
                                        Style="{StaticResource SpeedButtonStyle}"
                                        Content="Slow" Click="OnSpeedSelected"
                                        Tag="Slow" HorizontalAlignment="Stretch"/>
                                    <Button x:Name="BtnSpeedMedium" Grid.Column="1"
                                        Style="{StaticResource SpeedButtonStyle}"
                                        Content="Medium" Click="OnSpeedSelected"
                                        Tag="Medium" HorizontalAlignment="Stretch"
                                        Background="{StaticResource SurfaceContainerLowestBrush}"
                                        Foreground="{StaticResource PrimaryAccentBrush}"/>
                                    <Button x:Name="BtnSpeedFast" Grid.Column="2"
                                        Style="{StaticResource SpeedButtonStyle}"
                                        Content="Fast" Click="OnSpeedSelected"
                                        Tag="Fast" HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Divider -->
                        <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>

                        <!-- SECTION: Style -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="STYLE"
                                FontSize="11" FontWeight="Bold"
                                CharacterSpacing="50"
                                Foreground="{StaticResource TextMutedBrush}"/>

                            <Border Background="{StaticResource SurfaceHighBrush}"
                                CornerRadius="10" Padding="14"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <!-- Show Shortcut Keys toggle -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Show Shortcut Keys" FontSize="13"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsShortcutKeys"
                                            Grid.Column="1" IsOn="True"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>

                                    <!-- Canvas Background -->
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Canvas Background" FontSize="13"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border x:Name="BgBlack"
                                                Width="24" Height="24" CornerRadius="12"
                                                Background="Black"
                                                BorderBrush="{StaticResource PrimaryAccentBrush}"
                                                BorderThickness="2"
                                                Tapped="OnBgColorSelected">
                                                <Border.Tag>Black</Border.Tag>
                                            </Border>
                                            <Border Width="24" Height="24" CornerRadius="12"
                                                Background="#1A1A1A"
                                                BorderBrush="Transparent" BorderThickness="2"
                                                Tapped="OnBgColorSelected">
                                                <Border.Tag>DarkGray</Border.Tag>
                                            </Border>
                                            <Border Width="24" Height="24" CornerRadius="12"
                                                BorderBrush="Transparent" BorderThickness="2"
                                                Tapped="OnBgColorSelected">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#1E1B4B" Offset="0"/>
                                                        <GradientStop Color="#4C1D95" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Tag>Purple</Border.Tag>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Opacity -->
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Opacity" FontSize="13"
                                                Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border Grid.Column="1"
                                                Background="{StaticResource SurfaceHighestBrush}"
                                                CornerRadius="4" Padding="6,2">
                                                <TextBlock x:Name="TbOpacity" Text="100%"
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextMutedBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Slider x:Name="OpacitySlider"
                                            Minimum="0" Maximum="100" Value="100"
                                            ValueChanged="OnOpacityChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- SECTION: Selected Zoom Properties -->
                        <StackPanel x:Name="ZoomPropertiesPanel" Spacing="12" Visibility="Collapsed">
                            <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ZOOM PROPERTIES"
                                    FontSize="11" FontWeight="Bold"
                                    CharacterSpacing="50"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                    Background="Transparent" BorderThickness="0" Padding="4"
                                    Click="OnDeleteZoomClicked">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"
                                        Foreground="{StaticResource ErrorBrush}"/>
                                </Button>
                            </Grid>
                            <Border Background="{StaticResource SurfaceHighBrush}"
                                CornerRadius="10" Padding="14"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Zoom Factor" FontSize="13"
                                                Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border Grid.Column="1"
                                                Background="{StaticResource PrimaryGlowBrush}"
                                                CornerRadius="4" Padding="6,2">
                                                <TextBlock x:Name="TbSelectedZoomFactor" Text="1.5x"
                                                    FontSize="11" FontWeight="SemiBold"
                                                    Foreground="{StaticResource PrimaryAccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Slider x:Name="SelectedZoomSlider"
                                            Minimum="1" Maximum="4" Value="1.5" StepFrequency="0.1"
                                            ValueChanged="OnSelectedZoomFactorChanged"/>
                                    </StackPanel>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Start (sec)" FontSize="11"
                                                Foreground="{StaticResource TextMutedBrush}"/>
                                            <NumberBox x:Name="NbZoomStart"
                                                Minimum="0" SmallChange="0.1"
                                                BorderBrush="{StaticResource GlassBorderBrush}"
                                                Background="{StaticResource SurfaceContainerLowestBrush}"
                                                Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="End (sec)" FontSize="11"
                                                Foreground="{StaticResource TextMutedBrush}"/>
                                            <NumberBox x:Name="NbZoomEnd"
                                                Minimum="0" SmallChange="0.1"
                                                BorderBrush="{StaticResource GlassBorderBrush}"
                                                Background="{StaticResource SurfaceContainerLowestBrush}"
                                                Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- SECTION: Audio Controls -->
                        <StackPanel Spacing="12">
                            <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>
                            <TextBlock Text="SES KONTROLLERİ"
                                FontSize="11" FontWeight="Bold"
                                CharacterSpacing="50"
                                Foreground="{StaticResource TextMutedBrush}"/>

                            <Border Background="{StaticResource SurfaceHighBrush}"
                                CornerRadius="10" Padding="14"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <!-- Mic Volume -->
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Mikrofon Seviyesi" FontSize="13"
                                                Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbMicVolVal" Grid.Column="1" Text="100%"
                                                FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider x:Name="MicVolumeSlider" Minimum="0" Maximum="100" Value="100"
                                            ValueChanged="OnMicVolumeChanged"/>
                                    </StackPanel>

                                    <!-- System Volume -->
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Sistem Sesi Seviyesi" FontSize="13"
                                                Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbSysVolVal" Grid.Column="1" Text="100%"
                                                FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider x:Name="SysVolumeSlider" Minimum="0" Maximum="100" Value="100"
                                            ValueChanged="OnSysVolumeChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- SECTION: Camera & Watermark -->
                        <StackPanel Spacing="12">
                            <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>
                            <TextBlock Text="KAMERA &amp; FİLİGRAN"
                                FontSize="11" FontWeight="Bold"
                                CharacterSpacing="50"
                                Foreground="{StaticResource TextMutedBrush}"/>

                            <Border Background="{StaticResource SurfaceHighBrush}"
                                CornerRadius="10" Padding="14"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <!-- Camera Visibility -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Kamera Katmanı" FontSize="13"
                                            Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsCameraVisible" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.CameraVisible, Mode=TwoWay}"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>

                                    <!-- Watermark Toggle & Text -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Filigran Göster" FontSize="13"
                                            Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsWatermark" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.Watermark, Mode=TwoWay}"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                    <TextBox x:Name="TbWatermarkText"
                                        Text="{x:Bind ViewModel.WatermarkText, Mode=TwoWay}"
                                        PlaceholderText="Filigran Metni"
                                        FontSize="12" CornerRadius="6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ====================================================
             ROW 2: TIMELINE AREA
             ==================================================== -->
        <Border Grid.Row="2"
            Background="{StaticResource SurfaceContainerLowBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Timeline toolbar -->
                    <RowDefinition Height="44"/>
                    <!-- Tracks area -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TIMELINE TOOLBAR -->
                <Border Grid.Row="0"
                    Background="{StaticResource GlassNavBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Edit tools (left) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}" Click="OnUndoClicked"
                                ToolTipService.ToolTip="Geri Al (Ctrl+Z)">
                                <FontIcon Glyph="&#xE7A7;" FontSize="16"
                                    Foreground="{StaticResource TextMutedBrush}"/>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Click="OnRedoClicked"
                                ToolTipService.ToolTip="Yinele (Ctrl+Y)">
                                <FontIcon Glyph="&#xE7A6;" FontSize="16"
                                    Foreground="{StaticResource TextMutedBrush}"/>
                            </Button>
                            <Rectangle Width="1" Height="18" Fill="{StaticResource GlassBorderBrush}" Margin="6,0"/>
                            <Button Style="{StaticResource IconButtonStyle}" Click="OnSplitClicked"
                                ToolTipService.ToolTip="Böl (S)">
                                <FontIcon Glyph="&#xE8C6;" FontSize="16"
                                    Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Click="OnDeleteZoomClicked"
                                ToolTipService.ToolTip="Sil (Del)">
                                <FontIcon Glyph="&#xE74D;" FontSize="16"
                                    Foreground="{StaticResource ErrorBrush}"/>
                            </Button>
                        </StackPanel>

                        <!-- Play controls + timecode (center) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center">

                            <Border Background="#660D0E15" CornerRadius="6" Padding="10,4"
                                BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock x:Name="TbTimelineCurrent" Text="00:01:23"
                                        FontSize="13" FontWeight="SemiBold"
                                        FontFamily="Consolas"
                                        Foreground="{StaticResource PrimaryAccentBrush}"/>
                                    <TextBlock Text="/" FontSize="13"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TbTimelineTotal" Text="00:05:00"
                                        FontSize="13" FontFamily="Consolas"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceHighBrush}"
                                CornerRadius="8" Padding="3"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Style="{StaticResource PlayControlStyle}"
                                        Click="OnSkipPrevClicked">
                                        <FontIcon Glyph="&#xE76B;" FontSize="18"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Button>
                                    <Button x:Name="BtnPlayPause"
                                        Style="{StaticResource PlayControlStyle}"
                                        Background="{StaticResource PrimaryAccentBrush}"
                                        Click="OnPlayPauseClicked" CornerRadius="6">
                                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="18"
                                            Foreground="#1000A9"/>
                                    </Button>
                                    <Button Style="{StaticResource PlayControlStyle}"
                                        Click="OnSkipNextClicked">
                                        <FontIcon Glyph="&#xE76C;" FontSize="18"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Button>
                                    <Rectangle Width="1" Height="20" Fill="{StaticResource GlassBorderBrush}" Margin="4,0"/>
                                    <Button x:Name="BtnMuteAudio" Style="{StaticResource PlayControlStyle}"
                                        Click="OnMuteClicked">
                                        <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="16"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Zoom slider (right) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71F;" FontSize="14"
                                Foreground="{StaticResource TextMutedBrush}"/>
                            <Slider x:Name="TimelineZoomSlider"
                                Width="100" Minimum="1" Maximum="100" Value="50"
                                ValueChanged="OnTimelineZoomChanged"/>
                            <FontIcon Glyph="&#xE8A3;" FontSize="14"
                                Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TRACKS AREA -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Track headers -->
                        <ColumnDefinition Width="200"/>
                        <!-- Scrollable timeline content -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TRACK HEADERS -->
                    <Border Grid.Column="0"
                        Background="{StaticResource SurfaceContainerBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="0,0,1,0">
                        <StackPanel>
                            <!-- Time ruler spacer -->
                            <Border Height="22"
                                Background="{StaticResource SurfaceContainerLowestBrush}"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="0,0,0,1"/>

                            <!-- Video track header -->
                            <Border Height="72"
                                Background="Transparent"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE714;" FontSize="16"
                                            Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <TextBlock Text="Screen Recording" FontSize="12" FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                        <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24">
                                            <FontIcon Glyph="&#xE7B3;" FontSize="12"
                                                Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24">
                                            <FontIcon Glyph="&#xE785;" FontSize="12"
                                                Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Zoom effects track header -->
                            <Border Height="56"
                                Background="Transparent"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A3;" FontSize="16"
                                            Foreground="{StaticResource TertiaryBrush}"/>
                                        <TextBlock Text="Zoom Effects" FontSize="12" FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                        Width="24" Height="24" Click="OnAddZoomClicked"
                                        ToolTipService.ToolTip="Add Zoom Effect">
                                        <FontIcon Glyph="&#xE710;" FontSize="12"
                                            Foreground="{StaticResource TertiaryBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- SCROLLABLE TIMELINE CONTENT -->
                    <ScrollViewer Grid.Column="1"
                        x:Name="TimelineScrollViewer"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="TimelineContentGrid" MinWidth="800">
                            <Grid.RowDefinitions>
                                <!-- Time ruler -->
                                <RowDefinition Height="22"/>
                                <!-- Video track -->
                                <RowDefinition Height="72"/>
                                <!-- Zoom track -->
                                <RowDefinition Height="56"/>
                            </Grid.RowDefinitions>

                            <!-- TIME RULER -->
                            <Canvas Grid.Row="0"
                                x:Name="TimeRuler"
                                Background="{StaticResource SurfaceContainerLowestBrush}"
                                Height="22"
                                PointerPressed="OnTimelinePointerPressed"
                                PointerMoved="OnTimelinePointerMoved"
                                PointerReleased="OnTimelinePointerReleased">
                                <!-- Ruler ticks are generated in code-behind -->
                            </Canvas>

                            <!-- VIDEO TRACK -->
                            <Canvas Grid.Row="1"
                                x:Name="VideoTrack"
                                Background="#080D0E15"
                                PointerPressed="OnTimelinePointerPressed"
                                PointerMoved="OnTimelinePointerMoved"
                                PointerReleased="OnTimelinePointerReleased">
                                <!-- Video clip block (drawn in code-behind) -->
                                <Border
                                    x:Name="VideoClipBlock"
                                    Height="56"
                                    Background="{StaticResource VideoTrackBgBrush}"
                                    BorderBrush="{StaticResource VideoTrackBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Canvas.Left="40"
                                    Canvas.Top="8">
                                    <TextBlock Text="recording_1.mp4" FontSize="11" FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryAccentBrush}"
                                        Margin="8,4,0,0" VerticalAlignment="Top"/>
                                </Border>
                            </Canvas>

                            <!-- ZOOM EFFECTS TRACK -->
                            <Canvas Grid.Row="2"
                                x:Name="ZoomTrack"
                                Background="#030D0E15"
                                DoubleTapped="OnZoomTrackDoubleTapped">
                                <!-- Zoom pills are added dynamically in code-behind -->
                            </Canvas>

                            <!-- PLAYHEAD (spans all rows, rendered on top) -->
                            <Canvas Grid.Row="0" Grid.RowSpan="3"
                                IsHitTestVisible="False" ZIndex="100">
                                <Rectangle
                                    x:Name="PlayheadLine"
                                    Width="2"
                                    Height="150"
                                    Fill="{StaticResource SecondaryBrush}"
                                    Canvas.Left="200"
                                    Canvas.Top="0"/>
                                <!-- Playhead triangle -->
                                <Polygon
                                    x:Name="PlayheadTriangle"
                                    Fill="{StaticResource SecondaryBrush}"
                                    Points="-7,0 7,0 0,12"
                                    Canvas.Left="0"
                                    Canvas.Top="0"/>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
