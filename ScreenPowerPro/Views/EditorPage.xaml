<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenPowerPro.Views.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ScreenPowerPro.Models"
    mc:Ignorable="d"
    IsTabStop="True"
    KeyDown="OnPageKeyDown"
    Background="{StaticResource SurfaceContainerLowestBrush}">

    <Page.Resources>
        <!-- Small icon button style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SpeedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="PlayControlStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Sidebar Tab Button Style -->
        <Style x:Key="SidebarTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <!-- Preset Button Style -->
        <Style x:Key="PresetTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Nav Bar -->
            <RowDefinition Height="48" />
            <!-- Main workspace: FocuSee Left Sidebar + Video Preview -->
            <RowDefinition Height="*" />
            <!-- Timeline -->
            <RowDefinition Height="270" />
        </Grid.RowDefinitions>

        <!-- ====================================================
             ROW 0: TOP NAV BAR
             ==================================================== -->
        <Border Grid.Row="0"
            Background="{StaticResource GlassNavBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Padding="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>

                <!-- Left: Back + project name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Click="OnBackClicked"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="6" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TbBtnBackText" Text="Recorder" FontSize="13"
                                Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="16" Fill="{StaticResource GlassBorderBrush}"/>
                    <FontIcon Glyph="&#xE8D2;" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="TbProjectName" Text="Untitled Recording.mp4"
                        FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                        VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: timecode badge & drag area -->
                <Border x:Name="TitleBarDragArea" Grid.Column="1" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center"
                        Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="#660D0E15" CornerRadius="6" Padding="10,4"
                            BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="TbCurrentTime" Text="00:00:00"
                                    FontSize="13" FontWeight="SemiBold"
                                    FontFamily="Consolas"
                                    Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock Text="/" FontSize="13"
                                    Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TbTotalTime" Text="00:00:00"
                                    FontSize="13" FontFamily="Consolas"
                                    Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right: Save + Export -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="BtnSave" Click="OnSaveClicked"
                        Background="{StaticResource SurfaceHighBrush}"
                        BorderThickness="0" CornerRadius="8" Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TbBtnSaveText" Text="Save" FontSize="13" FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnExport" Click="OnExportClicked"
                        BorderThickness="0" CornerRadius="8" Padding="18,7">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#C0C1FF" Offset="0.0"/>
                                <GradientStop Color="#A078FF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE898;" FontSize="13" Foreground="#1000A9"/>
                            <TextBlock x:Name="TbBtnExportText" Text="Export" FontSize="13" FontWeight="Bold" Foreground="#1000A9"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Far Right: Space reserved for Window Caption Buttons -->
                <Border Grid.Column="3" Width="140" Background="Transparent" />
            </Grid>
        </Border>

        <!-- ====================================================
             ROW 1: MAIN WORKSPACE — FOCUSEE LEFT SIDEBAR + VIDEO PREVIEW
             ==================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 0: Icon Bar (48px) -->
                <ColumnDefinition Width="48" />
                <!-- 1: Tab Detail Flyout (280px) -->
                <ColumnDefinition Width="280" />
                <!-- 2: Video Canvas (*) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 0: VERTICAL ICON TAB BAR (FOCUSEE STYLE) -->
            <Border Grid.Column="0"
                Background="{StaticResource SurfaceContainerLowestBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="6" Padding="4,12" HorizontalAlignment="Center">
                        <!-- Cursor -->
                        <Button x:Name="TabBtnCursor" Style="{StaticResource SidebarTabButtonStyle}"
                            Click="OnSidebarTabClicked" Tag="cursor"
                            Background="#26C0C1FF"
                            ToolTipService.ToolTip="Cursor (İmleç Ayarları)">
                            <PathIcon x:Name="IconTabCursor" Data="M 0,0 L 0,16 L 4.5,12.5 L 8.5,20 L 11,18.5 L 7,11.5 L 13,11.5 Z" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        </Button>
                        <!-- Canvas Size -->
                        <Button x:Name="TabBtnCanvas" Style="{StaticResource SidebarTabButtonStyle}"
                            Click="OnSidebarTabClicked" Tag="canvas"
                            ToolTipService.ToolTip="Canvas Size &amp; Style (Tuval)">
                            <FontIcon Glyph="&#xE799;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>
                        <!-- Microphone Audio -->
                        <Button x:Name="TabBtnAudio" Style="{StaticResource SidebarTabButtonStyle}"
                            Click="OnSidebarTabClicked" Tag="audio"
                            ToolTipService.ToolTip="Microphone Audio (Mikrofon)">
                            <FontIcon Glyph="&#xE720;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>
                        <!-- Shortcut Keys -->
                        <Button x:Name="TabBtnKeys" Style="{StaticResource SidebarTabButtonStyle}"
                            Click="OnSidebarTabClicked" Tag="keys"
                            ToolTipService.ToolTip="Shortcut Keys (Kısayol Tuşları)">
                            <FontIcon Glyph="&#xE765;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>
                        <!-- Motion & Blur -->
                        <Button x:Name="TabBtnMotion" Style="{StaticResource SidebarTabButtonStyle}"
                            Click="OnSidebarTabClicked" Tag="motion"
                            ToolTipService.ToolTip="Motion &amp; Blur (Hareket &amp; Bulanıklık)">
                            <FontIcon Glyph="&#xE74B;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>
                        <Rectangle Width="26" Height="1" Fill="{StaticResource GlassBorderBrush}" Margin="0,4"/>
                        <!-- Camera -->
                        <Button x:Name="TabBtnCamera" Style="{StaticResource SidebarTabButtonStyle}"
                            Click="OnSidebarTabClicked" Tag="camera"
                            ToolTipService.ToolTip="Camera Overlay (Kamera)">
                            <FontIcon Glyph="&#xE722;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>
                        <!-- Audio Mixer -->
                        <Button x:Name="TabBtnVolume" Style="{StaticResource SidebarTabButtonStyle}"
                            Click="OnSidebarTabClicked" Tag="volume"
                            ToolTipService.ToolTip="Volume Mixer (Ses Mikseri)">
                            <FontIcon Glyph="&#xE767;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>
                        <!-- Watermark -->
                        <Button x:Name="TabBtnWatermark" Style="{StaticResource SidebarTabButtonStyle}"
                            Click="OnSidebarTabClicked" Tag="watermark"
                            ToolTipService.ToolTip="Watermark (Filigran)">
                            <FontIcon Glyph="&#xE734;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>
                        <!-- Zoom Props -->
                        <Button x:Name="TabBtnZoom" Style="{StaticResource SidebarTabButtonStyle}"
                            Click="OnSidebarTabClicked" Tag="zoom"
                            ToolTipService.ToolTip="Zoom Effect Properties (Zoom Detay)">
                            <FontIcon Glyph="&#xE71E;" FontSize="16" Foreground="{StaticResource TertiaryBrush}"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 1: TAB DETAILS PANEL (FOCUSEE CONTENT) -->
            <Border Grid.Column="1"
                Background="{StaticResource SurfaceContainerBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel Spacing="16">

                        <!-- ==================== TAB 1: CURSOR ==================== -->
                        <StackPanel x:Name="PanelTabCursor" Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M 0,0 L 0,16 L 4.5,12.5 L 8.5,20 L 11,18.5 L 7,11.5 L 13,11.5 Z" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbTitleCursor" Text="CURSOR" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                    Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Show Cursor -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TbShowCursor" Text="Show Cursor" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="TsShowCursor" Grid.Column="1"
                                        IsOn="{x:Bind ViewModel.CursorVisible, Mode=TwoWay}"
                                        OnContent="" OffContent="" Margin="0"/>
                                </Grid>
                            </Border>

                            <!-- Cursor Size -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbCursorSize" Text="Cursor Size" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TbCursorSizeVal" Grid.Column="1" Text="1.0x" FontSize="12" FontWeight="SemiBold"
                                            Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnResetCursorSize" Grid.Column="2" Content="Reset" FontSize="11" Padding="6,2"
                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}"
                                            Click="OnResetCursorSizeClicked"/>
                                    </Grid>
                                    <Slider x:Name="CursorSizeSlider" Minimum="1.0" Maximum="5.0" Value="1.0" StepFrequency="0.1"
                                        ValueChanged="OnCursorSizeSliderChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Cursor Style (10 Shapes) -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbCursorStyle" Text="Cursor Style" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="TbCursorStyleCount" Grid.Column="1" Text="10 Şekil" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Grid>
                                    <Grid ColumnSpacing="6" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- 1: White Arrow (Default) -->
                                        <Button x:Name="BtnCursorDefault" Grid.Row="0" Grid.Column="0" Click="OnCursorStyleSelected" Tag="default"
                                            Background="#26C0C1FF" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1"
                                            CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" ToolTipService.ToolTip="Beyaz Ok (Varsayılan)">
                                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                <PathIcon Data="M 0,0 L 0,14 L 4,11 L 7.5,17.5 L 9.5,16.5 L 6,10 L 11,10 Z" Foreground="White" Width="14" Height="14"/>
                                                <TextBlock Text="White" FontSize="9" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- 2: Black Arrow -->
                                        <Button x:Name="BtnCursorBlack" Grid.Row="0" Grid.Column="1" Click="OnCursorStyleSelected" Tag="arrow_black"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" ToolTipService.ToolTip="Siyah Ok">
                                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                <PathIcon Data="M 0,0 L 0,14 L 4,11 L 7.5,17.5 L 9.5,16.5 L 6,10 L 11,10 Z" Foreground="#3F3F46" Width="14" Height="14"/>
                                                <TextBlock Text="Black" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- 3: Hand Pointer -->
                                        <Button x:Name="BtnCursorHand" Grid.Row="0" Grid.Column="2" Click="OnCursorStyleSelected" Tag="pointer_hand"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" ToolTipService.ToolTip="Tıklama Eli">
                                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE962;" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="Hand" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- 4: Crosshair -->
                                        <Button x:Name="BtnCursorCrosshair" Grid.Row="0" Grid.Column="3" Click="OnCursorStyleSelected" Tag="crosshair"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" ToolTipService.ToolTip="Hassas Nişangah">
                                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE738;" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="Cross" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- 5: Dot / Circle -->
                                        <Button x:Name="BtnCursorDot" Grid.Row="0" Grid.Column="4" Click="OnCursorStyleSelected" Tag="circle_dot"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" ToolTipService.ToolTip="Dairesel Odak">
                                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xEA3B;" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="Dot" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- 6: I-Beam -->
                                        <Button x:Name="BtnCursorIBeam" Grid.Row="1" Grid.Column="0" Click="OnCursorStyleSelected" Tag="ibeam"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" ToolTipService.ToolTip="Metin Seçici">
                                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE8AC;" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="Beam" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- 7: Spotlight -->
                                        <Button x:Name="BtnCursorSpotlight" Grid.Row="1" Grid.Column="1" Click="OnCursorStyleSelected" Tag="spotlight"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" ToolTipService.ToolTip="Spot Işığı">
                                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE753;" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="Spot" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- 8: Yellow Highlight -->
                                        <Button x:Name="BtnCursorHighlightYellow" Grid.Row="1" Grid.Column="2" Click="OnCursorStyleSelected" Tag="highlight_yellow"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" ToolTipService.ToolTip="Sarı Vurgulayıcı">
                                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE7E6;" FontSize="13" Foreground="#FACC15"/>
                                                <TextBlock Text="Glow" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- 9: Cyan Arrow -->
                                        <Button x:Name="BtnCursorCyan" Grid.Row="1" Grid.Column="3" Click="OnCursorStyleSelected" Tag="arrow_cyan"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" ToolTipService.ToolTip="Camgöbeği Ok">
                                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                <PathIcon Data="M 0,0 L 0,14 L 4,11 L 7.5,17.5 L 9.5,16.5 L 6,10 L 11,10 Z" Foreground="#00E5FF" Width="14" Height="14"/>
                                                <TextBlock Text="Cyan" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- 10: Violet Arrow -->
                                        <Button x:Name="BtnCursorPurple" Grid.Row="1" Grid.Column="4" Click="OnCursorStyleSelected" Tag="arrow_purple"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" ToolTipService.ToolTip="Mor / Neon Ok">
                                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                <PathIcon Data="M 0,0 L 0,14 L 4,11 L 7.5,17.5 L 9.5,16.5 L 6,10 L 11,10 Z" Foreground="#C0C1FF" Width="14" Height="14"/>
                                                <TextBlock Text="Purple" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Click Effect Grid (None, Default, Ripple, Ring, Diffusion, Spotlight, Sparkle, Firework, Christmas) -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="TbClickEffect" Text="Click Effect" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Grid ColumnSpacing="6" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button x:Name="BtnClickNone" Grid.Row="0" Grid.Column="0" Content="None" FontSize="10"
                                            Click="OnClickEffectSelected" Tag="none" HorizontalAlignment="Stretch" CornerRadius="6" Padding="2,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnClickDefault" Grid.Row="0" Grid.Column="1" Content="Default" FontSize="10"
                                            Click="OnClickEffectSelected" Tag="default" HorizontalAlignment="Stretch" CornerRadius="6" Padding="2,6"
                                            Background="#26C0C1FF" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <Button x:Name="BtnClickRipple" Grid.Row="0" Grid.Column="2" Content="Ripple" FontSize="10"
                                            Click="OnClickEffectSelected" Tag="ripple" HorizontalAlignment="Stretch" CornerRadius="6" Padding="2,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnClickRing" Grid.Row="1" Grid.Column="0" Content="Ring" FontSize="10"
                                            Click="OnClickEffectSelected" Tag="ring" HorizontalAlignment="Stretch" CornerRadius="6" Padding="2,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnClickDiffusion" Grid.Row="1" Grid.Column="1" Content="Diffusion" FontSize="10"
                                            Click="OnClickEffectSelected" Tag="diffusion" HorizontalAlignment="Stretch" CornerRadius="6" Padding="2,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnClickSpotlight" Grid.Row="1" Grid.Column="2" Content="Spotlight" FontSize="10"
                                            Click="OnClickEffectSelected" Tag="spotlight" HorizontalAlignment="Stretch" CornerRadius="6" Padding="2,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnClickSparkle" Grid.Row="2" Grid.Column="0" Content="Sparkle" FontSize="10"
                                            Click="OnClickEffectSelected" Tag="sparkle" HorizontalAlignment="Stretch" CornerRadius="6" Padding="2,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnClickFirework" Grid.Row="2" Grid.Column="1" Content="Firework" FontSize="10"
                                            Click="OnClickEffectSelected" Tag="firework" HorizontalAlignment="Stretch" CornerRadius="6" Padding="2,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnClickChristmas" Grid.Row="2" Grid.Column="2" Content="Christmas" FontSize="10"
                                            Click="OnClickEffectSelected" Tag="christmas" HorizontalAlignment="Stretch" CornerRadius="6" Padding="2,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Cursor Sounds & Idle Toggles -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbCursorClickSound" Text="Cursor Click Sound" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsCursorSound" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.CursorClickSound, Mode=TwoWay}"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbHideCursorIdle" Text="Hide Cursor When Idle" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsHideIdleCursor" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.HideCursorWhenIdle, Mode=TwoWay}"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Raw Cursor Information Badge -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <TextBlock x:Name="TbRawCursorInfoTitle" Text="Ham Kayıt Fare İmleci" FontSize="12" FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TbRawCursorInfoDesc"
                                        Text="Kayıt esnasında 'Ham Kayıtta Fare İmlecini Gizle' seçildiğinde videodaki orijinal imleç kaydedilmez ve yalnızca burada seçtiğiniz özel imleç görünür."
                                        FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="15"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 2: CANVAS SIZE & STYLE ==================== -->
                        <StackPanel x:Name="PanelTabCanvas" Spacing="14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE799;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbTitleCanvas" Text="CANVAS SIZE &amp; STYLE" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                    Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Aspect Ratio Buttons -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="TbAspectRatio" Text="Aspect Ratio" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnRatioOrig" Grid.Column="0" Content="Auto" FontSize="10"
                                            Click="OnCanvasRatioSelected" Tag="Original" HorizontalAlignment="Stretch" CornerRadius="6" Padding="0,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnRatio169" Grid.Column="1" Content="16:9" FontSize="10"
                                            Click="OnCanvasRatioSelected" Tag="16:9" HorizontalAlignment="Stretch" CornerRadius="6" Padding="0,6"
                                            Background="#26C0C1FF" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <Button x:Name="BtnRatio11" Grid.Column="2" Content="1:1" FontSize="10"
                                            Click="OnCanvasRatioSelected" Tag="1:1" HorizontalAlignment="Stretch" CornerRadius="6" Padding="0,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnRatio43" Grid.Column="3" Content="4:3" FontSize="10"
                                            Click="OnCanvasRatioSelected" Tag="4:3" HorizontalAlignment="Stretch" CornerRadius="6" Padding="0,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnRatio916" Grid.Column="4" Content="9:16" FontSize="10"
                                            Click="OnCanvasRatioSelected" Tag="9:16" HorizontalAlignment="Stretch" CornerRadius="6" Padding="0,6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Style Sliders (Padding, Inset, Roundness, Shadow) -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbFixedZoom" Text="Fixed Zoom Part" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsFixedZoom" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.FixedZoomPart, Mode=TwoWay}"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>

                                    <!-- Padding -->
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbPaddingLabel" Text="Padding" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbPaddingVal" Grid.Column="1" Text="5" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider x:Name="SliderPadding" Minimum="0" Maximum="20" Value="{x:Bind ViewModel.Padding, Mode=TwoWay}"
                                            ValueChanged="OnPaddingValueChanged"/>
                                    </StackPanel>

                                    <!-- Inset -->
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbInsetLabel" Text="Inset" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbInsetVal" Grid.Column="1" Text="0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider x:Name="SliderInset" Minimum="0" Maximum="10" Value="{x:Bind ViewModel.Inset, Mode=TwoWay}"
                                            ValueChanged="OnInsetValueChanged"/>
                                    </StackPanel>

                                    <!-- Roundness -->
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbRoundnessLabel" Text="Roundness" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbRoundnessVal" Grid.Column="1" Text="4" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider x:Name="SliderRoundness" Minimum="0" Maximum="20" Value="{x:Bind ViewModel.Roundness, Mode=TwoWay}"
                                            ValueChanged="OnRoundnessValueChanged"/>
                                    </StackPanel>

                                    <!-- Shadow -->
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbShadowLabel" Text="Shadow" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbShadowVal" Grid.Column="1" Text="100%" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider x:Name="SliderShadow" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Shadow, Mode=TwoWay}"
                                            ValueChanged="OnShadowValueChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Background Presets & Color Palette -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="TbBgPresetLabel" Text="Background Preset" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <!-- Preset tabs -->
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnPresetDefault" Grid.Column="0" Style="{StaticResource PresetTabButtonStyle}"
                                            Content="Default" Click="OnCanvasPresetSelected" Tag="Default"
                                            Background="#26C0C1FF" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnPresetSteady" Grid.Column="1" Style="{StaticResource PresetTabButtonStyle}"
                                            Content="Steady" Click="OnCanvasPresetSelected" Tag="Steady" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnPresetGraceful" Grid.Column="2" Style="{StaticResource PresetTabButtonStyle}"
                                            Content="Grace" Click="OnCanvasPresetSelected" Tag="Graceful" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnPresetScenery" Grid.Column="3" Style="{StaticResource PresetTabButtonStyle}"
                                            Content="Scene" Click="OnCanvasPresetSelected" Tag="Scenery" HorizontalAlignment="Stretch"/>
                                    </Grid>

                                    <!-- Color Swatches Grid -->
                                    <Grid ColumnSpacing="8" RowSpacing="8" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border x:Name="BgBlack" Grid.Row="0" Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                            Background="#0D0E15" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="2"
                                            Tapped="OnBgColorSelected" Tag="Black"/>
                                        <Border Grid.Row="0" Grid.Column="1" Width="26" Height="26" CornerRadius="13"
                                            Background="#1E1F27" BorderBrush="Transparent" BorderThickness="2"
                                            Tapped="OnBgColorSelected" Tag="DarkGray"/>
                                        <Border Grid.Row="0" Grid.Column="2" Width="26" Height="26" CornerRadius="13"
                                            Background="#1E1B4B" BorderBrush="Transparent" BorderThickness="2"
                                            Tapped="OnBgColorSelected" Tag="Purple"/>
                                        <Border Grid.Row="0" Grid.Column="3" Width="26" Height="26" CornerRadius="13"
                                            Background="#0C4A6E" BorderBrush="Transparent" BorderThickness="2"
                                            Tapped="OnBgColorSelected" Tag="Navy"/>
                                        <Border Grid.Row="0" Grid.Column="4" Width="26" Height="26" CornerRadius="13"
                                            Background="#064E3B" BorderBrush="Transparent" BorderThickness="2"
                                            Tapped="OnBgColorSelected" Tag="Emerald"/>
                                        <Border Grid.Row="0" Grid.Column="5" Width="26" Height="26" CornerRadius="13"
                                            Background="#4C0519" BorderBrush="Transparent" BorderThickness="2"
                                            Tapped="OnBgColorSelected" Tag="Crimson"/>

                                        <!-- Row 2: Gradients -->
                                        <Border Grid.Row="1" Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                            BorderBrush="Transparent" BorderThickness="2" Tapped="OnBgColorSelected" Tag="Grad1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#C0C1FF" Offset="0"/>
                                                    <GradientStop Color="#A078FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Width="26" Height="26" CornerRadius="13"
                                            BorderBrush="Transparent" BorderThickness="2" Tapped="OnBgColorSelected" Tag="Grad2">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                                    <GradientStop Color="#9333EA" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="2" Width="26" Height="26" CornerRadius="13"
                                            BorderBrush="Transparent" BorderThickness="2" Tapped="OnBgColorSelected" Tag="Grad3">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#EC4899" Offset="0"/>
                                                    <GradientStop Color="#F43F5E" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="3" Width="26" Height="26" CornerRadius="13"
                                            BorderBrush="Transparent" BorderThickness="2" Tapped="OnBgColorSelected" Tag="Grad4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#10B981" Offset="0"/>
                                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="4" Width="26" Height="26" CornerRadius="13"
                                            BorderBrush="Transparent" BorderThickness="2" Tapped="OnBgColorSelected" Tag="Grad5">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                                    <GradientStop Color="#EF4444" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="5" Width="26" Height="26" CornerRadius="13"
                                            BorderBrush="Transparent" BorderThickness="2" Tapped="OnBgColorSelected" Tag="Grad6">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#6366F1" Offset="0"/>
                                                    <GradientStop Color="#D946EF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>

                                    <!-- Opacity -->
                                    <StackPanel Spacing="4" Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbOpacityLabel" Text="Opacity" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbOpacity" Text="100%" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100"
                                            ValueChanged="OnOpacityChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 3: MICROPHONE AUDIO ==================== -->
                        <StackPanel x:Name="PanelTabAudio" Spacing="14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE720;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbTitleAudio" Text="MICROPHONE AUDIO" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                    Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Mute -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TbMuteMic" Text="Mute Microphone" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="TsMicMute" Grid.Column="1"
                                        IsOn="{x:Bind ViewModel.MicMuted, Mode=TwoWay}"
                                        OnContent="" OffContent="" Margin="0"/>
                                </Grid>
                            </Border>

                            <!-- Volume Enhancement -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbVolEnhance" Text="Volume Enhancement" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TbVolEnhanceVal" Grid.Column="1" Text="1.0x" FontSize="12" FontWeight="SemiBold"
                                            Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnResetVolEnhance" Grid.Column="2" Content="Reset" FontSize="11" Padding="6,2"
                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}"
                                            Click="OnResetVolumeEnhanceClicked"/>
                                    </Grid>
                                    <Slider x:Name="SliderVolEnhance" Minimum="0.5" Maximum="3.0" Value="{x:Bind ViewModel.VolumeEnhancement, Mode=TwoWay}" StepFrequency="0.1"
                                        ValueChanged="OnVolumeEnhanceChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Microphone Level Slider -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbMicLevel" Text="Microphone Level" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="TbMicVolVal" Grid.Column="1" Text="100%" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Grid>
                                    <Slider x:Name="MicVolumeSlider" Minimum="0" Maximum="100" Value="100"
                                        ValueChanged="OnMicVolumeChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Audio AI: Noise Reduction & Vocal Enhancement -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TbNoiseReduction" Text="Noise Reduction (AI)" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbNoiseReductionSub" Text="Filters background noise" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="TsNoiseReduction" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.AudioNoiseReduction, Mode=TwoWay}"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock x:Name="TbVocalEnhancement" Text="Vocal Enhancement" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="TbVocalEnhancementSub" Text="Ses netliğini ve frekansını yükseltir" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="TsVocalEnhance" Grid.Column="1"
                                                IsOn="{x:Bind ViewModel.VocalEnhancement, Mode=TwoWay}"
                                                OnContent="" OffContent="" Margin="0"/>
                                        </Grid>
                                        <Slider x:Name="SliderVocalEnhance" Minimum="0" Maximum="100"
                                            Value="{x:Bind ViewModel.VocalEnhancementAmount, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 4: SHORTCUT KEYS ==================== -->
                        <StackPanel x:Name="PanelTabKeys" Spacing="14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE765;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbTitleKeys" Text="SHORTCUT KEYS" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                    Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Display Toggles -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbDisplayShortcutKeys" Text="Display Shortcut Keys" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsShortcutKeys" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.ShowKeystrokes, Mode=TwoWay}"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbDisplaySingleKey" Text="Display Single Shortcut Key" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsDisplaySingleKey" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.DisplaySingleShortcutKey, Mode=TwoWay}"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Style & Color -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="TbKeyStyle" Text="Key Style" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnKeyStyleFilled" Grid.Column="0" Content="Filled" FontSize="11"
                                            Click="OnKeyStyleSelected" Tag="filled" HorizontalAlignment="Stretch" CornerRadius="6"
                                            Background="#26C0C1FF" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <Button x:Name="BtnKeyStyleOutline" Grid.Column="1" Content="Outline" FontSize="11"
                                            Click="OnKeyStyleSelected" Tag="outline" HorizontalAlignment="Stretch" CornerRadius="6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnKeyStyleMinimal" Grid.Column="2" Content="Minimal" FontSize="11"
                                            Click="OnKeyStyleSelected" Tag="minimal" HorizontalAlignment="Stretch" CornerRadius="6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                    </Grid>

                                    <!-- Size Slider -->
                                    <StackPanel Spacing="4" Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbKeySize" Text="Key Size" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbKeySizeVal" Grid.Column="1" Text="24" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider x:Name="SliderKeySize" Minimum="12" Maximum="48" Value="{x:Bind ViewModel.ShortcutSize, Mode=TwoWay}"
                                            ValueChanged="OnKeySizeChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Position 3x3 Grid -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="TbScreenPos" Text="Screen Position" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Grid HorizontalAlignment="Center" ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>
                                        <Button Click="OnKeyPosSelected" Tag="top-left" Grid.Row="0" Grid.Column="0" Content="TL" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Button Click="OnKeyPosSelected" Tag="top-center" Grid.Row="0" Grid.Column="1" Content="TC" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Button Click="OnKeyPosSelected" Tag="top-right" Grid.Row="0" Grid.Column="2" Content="TR" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Button Click="OnKeyPosSelected" Tag="mid-left" Grid.Row="1" Grid.Column="0" Content="ML" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Button Click="OnKeyPosSelected" Tag="center" Grid.Row="1" Grid.Column="1" Content="C" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Button Click="OnKeyPosSelected" Tag="mid-right" Grid.Row="1" Grid.Column="2" Content="MR" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Button Click="OnKeyPosSelected" Tag="bottom-left" Grid.Row="2" Grid.Column="0" Content="BL" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Button Click="OnKeyPosSelected" Tag="bottom-center" Grid.Row="2" Grid.Column="1" Content="BC" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#26C0C1FF" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <Button Click="OnKeyPosSelected" Tag="bottom-right" Grid.Row="2" Grid.Column="2" Content="BR" FontSize="9" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 5: MOTION & BLUR ==================== -->
                        <StackPanel x:Name="PanelTabMotion" Spacing="14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74B;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbTitleMotion" Text="MOTION &amp; BLUR" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                    Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Motion Blur Master Toggle -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TbMotionBlur" Text="Motion Blur" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="TsMotionBlur" Grid.Column="1"
                                        IsOn="{x:Bind ViewModel.MotionBlur, Mode=TwoWay}"
                                        OnContent="" OffContent="" Margin="0"/>
                                </Grid>
                            </Border>

                            <!-- Blur Sliders (Zoom-in, Screen, Cursor) -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <!-- Zoom-in Motion Blur -->
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbZoomBlur" Text="Zoom-in Motion Blur" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbZoomBlurVal" Grid.Column="1" Text="50%" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider x:Name="MotionBlurSlider" Minimum="0" Maximum="100" Value="50"
                                            ValueChanged="OnMotionBlurChanged"/>
                                    </StackPanel>

                                    <!-- Screen Motion Blur -->
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbScreenBlur" Text="Screen Motion Blur" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbScreenBlurVal" Grid.Column="1" Text="50%" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ScreenMotionBlurAmount, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <!-- Cursor Motion Blur -->
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbCursorBlur" Text="Cursor Motion Blur" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbCursorBlurVal" Grid.Column="1" Text="50%" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.CursorMotionBlurAmount, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Movement Speed Selectors -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbCursorMovement" Text="Cursor Movement" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsCursorMovement" Grid.Column="1" IsOn="True" OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                    <Grid ColumnSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnSpeedSlow" Grid.Column="0" Style="{StaticResource SpeedButtonStyle}"
                                            Content="Slow" Click="OnSpeedSelected" Tag="Slow" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnSpeedMedium" Grid.Column="1" Style="{StaticResource SpeedButtonStyle}"
                                            Content="Medium" Click="OnSpeedSelected" Tag="Medium" HorizontalAlignment="Stretch"
                                            Background="{StaticResource SurfaceContainerLowestBrush}" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <Button x:Name="BtnSpeedFast" Grid.Column="2" Style="{StaticResource SpeedButtonStyle}"
                                            Content="Fast" Click="OnSpeedSelected" Tag="Fast" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 6: CAMERA ==================== -->
                        <StackPanel x:Name="PanelTabCamera" Spacing="14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE722;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbTitleCamera" Text="CAMERA OVERLAY" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                    Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbCameraLayer" Text="Kamera Katmanı" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsCameraVisible" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.CameraVisible, Mode=TwoWay}"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>

                                    <TextBlock x:Name="TbCameraShape" Text="Kamera Şekli" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnCamCircle" Grid.Column="0" Content="Daire" FontSize="11"
                                            Click="OnCameraShapeSelected" Tag="circle" HorizontalAlignment="Stretch" CornerRadius="6"
                                            Background="#26C0C1FF" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <Button x:Name="BtnCamSquare" Grid.Column="1" Content="Kare" FontSize="11"
                                            Click="OnCameraShapeSelected" Tag="square" HorizontalAlignment="Stretch" CornerRadius="6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                        <Button x:Name="BtnCamRounded" Grid.Column="2" Content="Yuvarlak" FontSize="11"
                                            Click="OnCameraShapeSelected" Tag="rounded" HorizontalAlignment="Stretch" CornerRadius="6"
                                            Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 7: VOLUME MIXER ==================== -->
                        <StackPanel x:Name="PanelTabVolume" Spacing="14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE767;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbTitleVolume" Text="AUDIO MIXER" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                    Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <!-- Mic Volume -->
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbMicLevel2" Text="Mikrofon Seviyesi" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbMicVolVal2" Grid.Column="1" Text="100%" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.MicVolume, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <!-- System Volume -->
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbSysLevel" Text="Sistem Sesi Seviyesi" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbSysVolVal" Grid.Column="1" Text="100%" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                        <Slider x:Name="SysVolumeSlider" Minimum="0" Maximum="100" Value="100"
                                            ValueChanged="OnSysVolumeChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 8: WATERMARK ==================== -->
                        <StackPanel x:Name="PanelTabWatermark" Spacing="14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE734;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbTitleWatermark" Text="WATERMARK" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                    Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TbWatermarkShow" Text="Filigran Göster" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="TsWatermark" Grid.Column="1"
                                            IsOn="{x:Bind ViewModel.Watermark, Mode=TwoWay}"
                                            OnContent="" OffContent="" Margin="0"/>
                                    </Grid>
                                    <TextBox x:Name="TbWatermarkText"
                                        Text="{x:Bind ViewModel.WatermarkText, Mode=TwoWay}"
                                        PlaceholderText="Filigran Metni"
                                        FontSize="12" CornerRadius="6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 9: ZOOM PROPERTIES ==================== -->
                        <StackPanel x:Name="PanelTabZoom" Spacing="14" Visibility="Collapsed">
                            <StackPanel x:Name="ZoomPropertiesPanel" Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71E;" FontSize="16" Foreground="{StaticResource TertiaryBrush}"/>
                                        <TextBlock x:Name="TbTitleZoomProps" Text="ZOOM PROPERTIES" FontSize="12" FontWeight="Bold" CharacterSpacing="50"
                                            Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="4"
                                        Click="OnDeleteZoomClicked">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource ErrorBrush}"/>
                                    </Button>
                                </Grid>
                                <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="10" Padding="14"
                                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="14">
                                        <!-- Zoom Factor -->
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TbZoomFactor" Text="Zoom Factor" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Border Grid.Column="1" Background="{StaticResource PrimaryGlowBrush}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock x:Name="TbSelectedZoomFactor" Text="1.5x" FontSize="11" FontWeight="SemiBold"
                                                        Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                </Border>
                                            </Grid>
                                            <Slider x:Name="SelectedZoomSlider" Minimum="1" Maximum="4" Value="1.5" StepFrequency="0.1"
                                                ValueChanged="OnSelectedZoomFactorChanged"/>
                                        </StackPanel>

                                        <!-- Start / End Sec -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock x:Name="TbZoomStart" Text="Start (sec)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                <NumberBox x:Name="NbZoomStart" Minimum="0" SmallChange="0.1"
                                                    BorderBrush="{StaticResource GlassBorderBrush}"
                                                    Background="{StaticResource SurfaceContainerLowestBrush}"
                                                    Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock x:Name="TbZoomEnd" Text="End (sec)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                <NumberBox x:Name="NbZoomEnd" Minimum="0" SmallChange="0.1"
                                                    BorderBrush="{StaticResource GlassBorderBrush}"
                                                    Background="{StaticResource SurfaceContainerLowestBrush}"
                                                    Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 2: VIDEO CANVAS (CENTER) -->
            <Border Grid.Column="2"
                Margin="16"
                Background="#0D0E15"
                CornerRadius="12"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1">
                <Grid x:Name="VideoCanvasHost" SizeChanged="OnVideoCanvasHostSizeChanged">
                    <!-- Radial glow background -->
                    <Ellipse Width="600" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1AC0C1FF" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- 16:9 Video container -->
                    <Border
                        x:Name="VideoContainer"
                        MaxWidth="920"
                        CornerRadius="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="24">
                        <Border.Background>
                            <SolidColorBrush Color="#000000"/>
                        </Border.Background>

                        <Grid>
                            <!-- MediaPlayer with live zoom simulation transform -->
                            <MediaPlayerElement
                                x:Name="VideoPlayer"
                                AutoPlay="False"
                                AreTransportControlsEnabled="False"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MinHeight="200"
                                RenderTransformOrigin="0.5,0.5">
                                <MediaPlayerElement.RenderTransform>
                                    <CompositeTransform x:Name="VideoTransform" ScaleX="1.0" ScaleY="1.0" TranslateX="0" TranslateY="0"/>
                                </MediaPlayerElement.RenderTransform>
                            </MediaPlayerElement>

                            <!-- Dynamic Cursor & Click Effect Overlay Canvas -->
                            <Canvas x:Name="CursorOverlayCanvas"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5">
                                <Canvas.RenderTransform>
                                    <CompositeTransform x:Name="CursorCanvasTransform" ScaleX="1.0" ScaleY="1.0" TranslateX="0" TranslateY="0"/>
                                </Canvas.RenderTransform>
                            </Canvas>

                            <!-- Click overlay for play/pause -->
                            <Button
                                x:Name="VideoClickOverlay"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Click="OnVideoCanvasClicked"
                                PointerMoved="OnVideoPointerMoved"/>

                            <!-- Hover play button -->
                            <Border
                                x:Name="PlayOverlay"
                                Background="#660D0E15"
                                CornerRadius="10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Opacity="1"
                                IsHitTestVisible="False">
                                <Border
                                    Width="64" Height="64" CornerRadius="32"
                                    Background="#33C0C1FF"
                                    BorderBrush="#80C0C1FF" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon x:Name="PlayOverlayIcon"
                                        Glyph="&#xE768;" FontSize="28"
                                        Foreground="{StaticResource PrimaryAccentBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>

                            <!-- No video file warning message -->
                            <StackPanel
                                x:Name="NoVideoMessage"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                                <FontIcon Glyph="&#xE7BA;" FontSize="36" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TbNoVideoMessage" Text="Video Dosyası Yüklenemedi" FontSize="15" FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TbMissingVideoPath" Text="" FontSize="11"
                                    Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"/>
                            </StackPanel>

                            <!-- Resolution badge top-right -->
                            <Border
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="12"
                                Background="#990D0E15"
                                CornerRadius="6" Padding="8,4"
                                BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TbResolution" Text="1080p • 60fps"
                                        FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Zoom level badge bottom-left -->
                            <Border
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="12"
                                Background="#990D0E15"
                                CornerRadius="6" Padding="8,4"
                                BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71E;" FontSize="11"
                                        Foreground="{StaticResource PrimaryAccentBrush}"/>
                                    <TextBlock x:Name="ZoomLevelBadge" Text="1.0x"
                                        FontSize="11" FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ====================================================
             ROW 2: TIMELINE AREA (PROFESSIONAL NLE GRADE)
             ==================================================== -->
        <Border Grid.Row="2"
            Background="{StaticResource SurfaceContainerLowBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Timeline toolbar -->
                    <RowDefinition Height="44"/>
                    <!-- Tracks area -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TIMELINE TOOLBAR -->
                <Border Grid.Row="0"
                    Background="{StaticResource GlassNavBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Edit tools (left) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="BtnUndo" Style="{StaticResource IconButtonStyle}" Click="OnUndoClicked"
                                ToolTipService.ToolTip="Geri Al (Ctrl+Z)">
                                <FontIcon Glyph="&#xE7A7;" FontSize="15"
                                    Foreground="{StaticResource TextMutedBrush}"/>
                            </Button>
                            <Button x:Name="BtnRedo" Style="{StaticResource IconButtonStyle}" Click="OnRedoClicked"
                                ToolTipService.ToolTip="Yinele (Ctrl+Y)">
                                <FontIcon Glyph="&#xE7A6;" FontSize="15"
                                    Foreground="{StaticResource TextMutedBrush}"/>
                            </Button>
                            <Rectangle Width="1" Height="18" Fill="{StaticResource GlassBorderBrush}" Margin="4,0"/>
                            <Button x:Name="BtnSplit" Style="{StaticResource IconButtonStyle}" Click="OnSplitClicked"
                                ToolTipService.ToolTip="Böl / Cut (S)">
                                <FontIcon Glyph="&#xE8C6;" FontSize="15"
                                    Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Button>
                            <Button x:Name="BtnDeleteZoom" Style="{StaticResource IconButtonStyle}" Click="OnDeleteZoomClicked"
                                ToolTipService.ToolTip="Kırpılan Parçayı / Efekti Sil (Del)">
                                <FontIcon Glyph="&#xE74D;" FontSize="15"
                                    Foreground="{StaticResource ErrorBrush}"/>
                            </Button>
                            <Rectangle Width="1" Height="18" Fill="{StaticResource GlassBorderBrush}" Margin="4,0"/>
                            <Button x:Name="BtnAddZoom" Style="{StaticResource IconButtonStyle}" Click="OnAddZoomClicked"
                                ToolTipService.ToolTip="Zoom Efekti Ekle (+)">
                                <FontIcon Glyph="&#xE710;" FontSize="15"
                                    Foreground="{StaticResource TertiaryBrush}"/>
                            </Button>
                        </StackPanel>

                        <!-- Play controls + timecode (center) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center">

                            <Border Background="#660D0E15" CornerRadius="6" Padding="10,4"
                                BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock x:Name="TbTimelineCurrent" Text="00:01:23"
                                        FontSize="13" FontWeight="SemiBold"
                                        FontFamily="Consolas"
                                        Foreground="{StaticResource PrimaryAccentBrush}"/>
                                    <TextBlock Text="/" FontSize="13"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TbTimelineTotal" Text="00:05:00"
                                        FontSize="13" FontFamily="Consolas"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceHighBrush}"
                                CornerRadius="8" Padding="3"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Style="{StaticResource PlayControlStyle}"
                                        Click="OnSkipPrevClicked">
                                        <FontIcon Glyph="&#xE76B;" FontSize="18"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Button>
                                    <Button x:Name="BtnPlayPause"
                                        Style="{StaticResource PlayControlStyle}"
                                        Background="{StaticResource PrimaryAccentBrush}"
                                        Click="OnPlayPauseClicked" CornerRadius="6">
                                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="18"
                                            Foreground="#1000A9"/>
                                    </Button>
                                    <Button Style="{StaticResource PlayControlStyle}"
                                        Click="OnSkipNextClicked">
                                        <FontIcon Glyph="&#xE76C;" FontSize="18"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Button>
                                    <Rectangle Width="1" Height="20" Fill="{StaticResource GlassBorderBrush}" Margin="4,0"/>
                                    <Button x:Name="BtnMuteAudio" Style="{StaticResource PlayControlStyle}"
                                        Click="OnMuteClicked" ToolTipService.ToolTip="Tüm Sesleri Kapat">
                                        <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="16"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Zoom slider (right) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                            <FontIcon x:Name="IconZoomOut" Glyph="&#xE71F;" FontSize="13"
                                Foreground="{StaticResource TextMutedBrush}" ToolTipService.ToolTip="Timeline Daralt"/>
                            <Slider x:Name="TimelineZoomSlider"
                                Width="100" Minimum="1" Maximum="100" Value="50"
                                ValueChanged="OnTimelineZoomChanged"/>
                            <FontIcon x:Name="IconZoomIn" Glyph="&#xE8A3;" FontSize="13"
                                Foreground="{StaticResource TextMutedBrush}" ToolTipService.ToolTip="Timeline Genişlet (Ctrl+Tekerlek)"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TRACKS AREA (Track Headers + Scrollable Canvas Content) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Track headers column -->
                        <ColumnDefinition Width="200"/>
                        <!-- Scrollable timeline content column -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TRACK HEADERS (LEFT 200px) -->
                    <Border Grid.Column="0"
                        Background="{StaticResource SurfaceContainerBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="0,0,1,0">
                        <StackPanel>
                            <!-- Time ruler spacer (22px) -->
                            <Border Height="22"
                                Background="{StaticResource SurfaceContainerLowestBrush}"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="0,0,0,1"/>

                            <!-- Video track header (72px) -->
                            <Border Height="72"
                                Background="Transparent"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE714;" FontSize="16"
                                            Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TbTrackVideo" Text="Video Track" FontSize="12" FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbTrackVideoSub" Text="Screen Recording" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                        <Button x:Name="BtnVideoMute" Click="OnVideoTrackMuteClicked" Style="{StaticResource IconButtonStyle}" Width="24" Height="24"
                                            ToolTipService.ToolTip="Video Sesini Kapat/Aç">
                                            <FontIcon x:Name="IconVideoMute" Glyph="&#xE767;" FontSize="12"
                                                Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Audio track header (56px) -->
                            <Border Height="56"
                                Background="Transparent"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE720;" FontSize="16"
                                            Foreground="#22C55E"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TbTrackAudio" Text="Audio Track" FontSize="12" FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbTrackAudioSub" Text="Waveform / Mic" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                        <Button x:Name="BtnAudioMute" Click="OnAudioTrackMuteClicked" Style="{StaticResource IconButtonStyle}" Width="24" Height="24"
                                            ToolTipService.ToolTip="Ses Parçasını Kapat/Aç">
                                            <FontIcon x:Name="IconAudioMute" Glyph="&#xE767;" FontSize="12"
                                                Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Zoom effects track header (56px) -->
                            <Border Height="56"
                                Background="Transparent"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A3;" FontSize="16"
                                            Foreground="{StaticResource TertiaryBrush}"/>
                                        <TextBlock x:Name="TbTrackZoom" Text="Zoom Effects" FontSize="12" FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="BtnAddZoomTrack" Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                        Width="24" Height="24" Click="OnAddZoomClicked"
                                        ToolTipService.ToolTip="Zoom Efekti Ekle">
                                        <FontIcon Glyph="&#xE710;" FontSize="12"
                                            Foreground="{StaticResource TertiaryBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- SCROLLABLE TIMELINE CONTENT -->
                    <ScrollViewer Grid.Column="1"
                        x:Name="TimelineScrollViewer"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="TimelineContentGrid" MinWidth="800">
                            <Grid.RowDefinitions>
                                <!-- Time ruler -->
                                <RowDefinition Height="22"/>
                                <!-- Video track -->
                                <RowDefinition Height="72"/>
                                <!-- Audio track -->
                                <RowDefinition Height="56"/>
                                <!-- Zoom track -->
                                <RowDefinition Height="56"/>
                            </Grid.RowDefinitions>

                            <!-- TIME RULER (Row 0) -->
                            <Canvas Grid.Row="0"
                                x:Name="TimeRuler"
                                Background="{StaticResource SurfaceContainerLowestBrush}"
                                Height="22"
                                PointerPressed="OnTimelinePointerPressed"
                                PointerMoved="OnTimelinePointerMoved"
                                PointerReleased="OnTimelinePointerReleased">
                                <!-- Ruler ticks are generated in code-behind -->
                            </Canvas>

                            <!-- VIDEO TRACK (Row 1) -->
                            <Canvas Grid.Row="1"
                                x:Name="VideoTrack"
                                Background="#080D0E15"
                                PointerPressed="OnTimelinePointerPressed"
                                PointerMoved="OnTimelinePointerMoved"
                                PointerReleased="OnTimelinePointerReleased">
                                <!-- Base clip block (fallback/rendered in code-behind) -->
                                <Border
                                    x:Name="VideoClipBlock"
                                    Height="56"
                                    Background="{StaticResource VideoTrackBgBrush}"
                                    BorderBrush="{StaticResource VideoTrackBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Canvas.Left="40"
                                    Canvas.Top="8">
                                    <TextBlock Text="recording.mp4" FontSize="11" FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryAccentBrush}"
                                        Margin="8,4,0,0" VerticalAlignment="Top"/>
                                </Border>
                            </Canvas>

                            <!-- AUDIO TRACK (Row 2: Waveform Canvas) -->
                            <Canvas Grid.Row="2"
                                x:Name="AudioTrack"
                                Background="#0500FF88"
                                PointerPressed="OnAudioTrackPointerPressed"
                                PointerMoved="OnTimelinePointerMoved"
                                PointerReleased="OnTimelinePointerReleased">
                                <!-- Waveform bars and audio clips are drawn dynamically in code-behind -->
                            </Canvas>

                            <!-- ZOOM EFFECTS TRACK (Row 3) -->
                            <Canvas Grid.Row="3"
                                x:Name="ZoomTrack"
                                Background="#030D0E15"
                                DoubleTapped="OnZoomTrackDoubleTapped">
                                <!-- Zoom pills are added dynamically in code-behind -->
                            </Canvas>

                            <!-- PLAYHEAD (spans all 4 rows, rendered on top) -->
                            <Canvas Grid.Row="0" Grid.RowSpan="4"
                                IsHitTestVisible="False" ZIndex="100">
                                <Rectangle
                                    x:Name="PlayheadLine"
                                    Width="2"
                                    Height="206"
                                    Fill="{StaticResource SecondaryBrush}"
                                    Canvas.Left="200"
                                    Canvas.Top="0"/>
                                <Polygon
                                    x:Name="PlayheadTriangle"
                                    Fill="{StaticResource SecondaryBrush}"
                                    Points="-7,0 7,0 0,12"
                                    Canvas.Left="0"
                                    Canvas.Top="0"/>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- ====================================================
             EXPORT SETTINGS MODAL / POPUP DIALOG
             ==================================================== -->
        <Grid x:Name="ExportModalOverlay"
              Grid.Row="0" Grid.RowSpan="3"
              Visibility="Collapsed"
              Background="#B3090A10"
              Canvas.ZIndex="1000">

            <!-- Backdrop click dismiss -->
            <Border Background="Transparent" Tapped="OnExportBackdropTapped" />

            <!-- Dialog Container (Modern Dark Glassmorphism) -->
            <Border Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1E1F2A"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="26,22">

                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#26A078FF" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE898;" FontSize="16" Foreground="#C0C1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="TbExportModalTitle" Text="Dışa Aktarma Ayarları"
                                           FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TbExportModalSubtitle" Text="Çözünürlük, kare hızı ve kayıt yerini belirleyin."
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Click="OnCloseExportDialogClicked"
                                Background="Transparent" BorderThickness="0" CornerRadius="8" Width="32" Height="32" Padding="0">
                            <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>
                    </Grid>

                    <Rectangle Height="1" Fill="#1AFFFFFF" />

                    <!-- Resolution (Çözünürlük) -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE790;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock x:Name="TbExportResLabel" Text="Çözünürlük" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <ComboBox x:Name="CmbExportResolution" HorizontalAlignment="Stretch" CornerRadius="8"
                                  Background="#14151E" BorderBrush="#26FFFFFF" SelectionChanged="OnExportSettingChanged">
                            <ComboBoxItem Tag="4K" Content="4K Ultra HD (3840 × 2160)" />
                            <ComboBoxItem Tag="2K" Content="2K Quad HD (2560 × 1440)" />
                            <ComboBoxItem Tag="1080p" Content="1080p Full HD (1920 × 1080)" IsSelected="True" />
                            <ComboBoxItem Tag="720p" Content="720p HD (1280 × 720)" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Frame Rate & Format (Grid with 2 columns) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- FPS -->
                        <StackPanel Grid.Column="0" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbExportFpsLabel" Text="Kare Hızı (FPS)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbExportFps" HorizontalAlignment="Stretch" CornerRadius="8"
                                      Background="#14151E" BorderBrush="#26FFFFFF" SelectionChanged="OnExportSettingChanged">
                                <ComboBoxItem Tag="60" Content="60 FPS (Akıcı)" IsSelected="True" />
                                <ComboBoxItem Tag="30" Content="30 FPS (Standart)" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Format -->
                        <StackPanel Grid.Column="1" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B9;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                <TextBlock x:Name="TbExportFormatLabel" Text="Format" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbExportFormat" HorizontalAlignment="Stretch" CornerRadius="8"
                                      Background="#14151E" BorderBrush="#26FFFFFF" IsEnabled="False" SelectedIndex="0">
                                <ComboBoxItem Content="MP4 (H.264 / AAC)" IsSelected="True" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Save Location (Kayıt Yeri) -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED25;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock x:Name="TbExportLocationLabel" Text="Kayıt Konumu" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtExportPath"
                                     Grid.Column="0"
                                     CornerRadius="8"
                                     FontSize="12"
                                     Background="#14151E"
                                     BorderBrush="#26FFFFFF"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Padding="10,7" />
                            <Button x:Name="BtnBrowseExportPath"
                                    Grid.Column="1"
                                    Click="OnBrowseExportPathClicked"
                                    CornerRadius="8"
                                    Padding="14,7"
                                    Background="{StaticResource SurfaceHighBrush}"
                                    BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TbBtnBrowseText" Text="Gözat..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Summary Info Badge -->
                    <Border Background="#14151E" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,7">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock x:Name="TbExportSummaryBadge" Text="1920×1080 • 60 FPS • MP4 Video"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnCancelExportModal"
                                Grid.Column="0"
                                Click="OnCloseExportDialogClicked"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="#26FFFFFF"
                                CornerRadius="8"
                                Padding="16,7">
                            <TextBlock x:Name="TbBtnCancelExportText" Text="İptal" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>

                        <Button x:Name="BtnConfirmExport"
                                Grid.Column="1"
                                Click="OnConfirmExportClicked"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="20,8">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#C0C1FF" Offset="0.0"/>
                                    <GradientStop Color="#A078FF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE898;" FontSize="13" Foreground="#1000A9"/>
                                <TextBlock x:Name="TbBtnConfirmExportText" Text="Dışa Aktar" FontSize="13" FontWeight="Bold" Foreground="#1000A9"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
