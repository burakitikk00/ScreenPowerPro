<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenPowerPro.Views.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBgBrush}">

    <Grid>
        <!-- Atmospheric background glow -->
        <Ellipse
            Width="800" Height="800"
            HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#0DC0C1FF" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Main content -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="0">

            <!-- Progress Ring Container -->
            <Grid
                Width="256" Height="256"
                HorizontalAlignment="Center"
                Margin="0,0,0,40">

                <!-- Ring background glow -->
                <Ellipse Width="256" Height="256">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1AC0C1FF" Offset="0.6"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Dark circle background -->
                <Ellipse Width="248" Height="248"
                    Fill="{StaticResource SurfaceContainerLowestBrush}"
                    Stroke="{StaticResource GlassBorderBrush}"
                    StrokeThickness="1"/>

                <!-- Progress ring — track (background) -->
                <Ellipse
                    Width="232" Height="232"
                    StrokeThickness="10"
                    Fill="Transparent"
                    Stroke="{StaticResource SurfaceHighBrush}"
                    StrokeDashOffset="0"/>

                <!-- Progress ring — active (foreground) -->
                <!-- Circumference = 2 * pi * 116 ≈ 729  -->
                <!-- Dashoffset for 0%: 729; for 100%: 0 -->
                <Ellipse
                    x:Name="ProgressRingArc"
                    Width="232" Height="232"
                    StrokeThickness="10"
                    Fill="Transparent"
                    StrokeDashArray="729"
                    StrokeDashOffset="729"
                    RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#C0C1FF" Offset="0.0"/>
                            <GradientStop Color="#A078FF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Percentage text -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                    <TextBlock
                        x:Name="TbPercentage"
                        Text="0%"
                        FontSize="52"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        HorizontalAlignment="Center"
                        CharacterSpacing="-20"/>
                </StackPanel>
            </Grid>

            <!-- Status text -->
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,60">
                <TextBlock
                    x:Name="TbStatusTitle"
                    Text="Videounuz dışa aktarılıyor..."
                    FontSize="32"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    HorizontalAlignment="Center"
                    CharacterSpacing="-15"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <TextBlock
                        x:Name="TbEstimatedLabel"
                        Text="Lütfen uygulamayı kapatmayın. Tahmini kalan süre: "
                        FontSize="16"
                        Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock
                        x:Name="TbEstimatedTime"
                        Text="Hesaplanıyor..."
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryAccentBrush}"/>
                </StackPanel>

                <!-- Current operation label -->
                <TextBlock
                    x:Name="TbOperation"
                    Text="FFmpeg işlemi başlatılıyor..."
                    FontSize="13"
                    Foreground="{StaticResource TextMutedBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"/>

                <!-- File details -->
                <Border
                    Background="{StaticResource GlassNavBrush}"
                    CornerRadius="10" Padding="16,10"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock x:Name="TbFormatLabel" Text="FORMAT" FontSize="10" FontWeight="Bold"
                                CharacterSpacing="50"
                                Foreground="{StaticResource TextMutedBrush}"
                                HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TbFormat" Text="MP4 (H.264)"
                                FontSize="13" FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Rectangle Width="1" Fill="{StaticResource GlassBorderBrush}" Margin="0,4"/>
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock x:Name="TbResLabel" Text="RESOLUTION" FontSize="10" FontWeight="Bold"
                                CharacterSpacing="50"
                                Foreground="{StaticResource TextMutedBrush}"
                                HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TbResolution" Text="1920×1080"
                                FontSize="13" FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Rectangle Width="1" Fill="{StaticResource GlassBorderBrush}" Margin="0,4"/>
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock x:Name="TbFpsLabel" Text="FPS" FontSize="10" FontWeight="Bold"
                                CharacterSpacing="50"
                                Foreground="{StaticResource TextMutedBrush}"
                                HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TbFps" Text="60"
                                FontSize="13" FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Cancel button -->
            <Button
                x:Name="BtnCancel"
                Click="OnCancelClicked"
                HorizontalAlignment="Center"
                CornerRadius="999"
                Padding="28,12"
                BorderThickness="1"
                BorderBrush="{StaticResource GlassBorderBrush}"
                Background="{StaticResource GlassNavBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE711;" FontSize="16"
                        Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock
                        x:Name="TbBtnCancelText"
                        Text="Dışa Aktarmayı İptal Et"
                        FontSize="14" FontWeight="SemiBold"
                        Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Button>

            <!-- Done state (hidden initially) -->
            <StackPanel
                x:Name="DoneState"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                Spacing="12">
                <FontIcon Glyph="&#xE73E;" FontSize="48"
                    Foreground="#22C55E"
                    HorizontalAlignment="Center"/>
                <TextBlock x:Name="TbDoneTitle" Text="Export Tamamlandı!"
                    FontSize="24" FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button x:Name="BtnOpenFolder"
                        Click="OnOpenFolderClicked"
                        Background="{StaticResource SurfaceHighBrush}"
                        BorderThickness="0" CornerRadius="8" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14"
                                Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TbBtnOpenFolderText" Text="Klasörü Aç" FontSize="13" FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnBackToEditor"
                        Click="OnBackToEditorClicked"
                        BorderThickness="0" CornerRadius="8" Padding="18,8">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#C0C1FF" Offset="0.0"/>
                                <GradientStop Color="#A078FF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <TextBlock x:Name="TbBtnBackToEditorText" Text="Editöre Dön" FontSize="13" FontWeight="Bold"
                            Foreground="#1000A9"/>
                    </Button>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
