<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenPowerPro.Views.MaskOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Bölge Maskesi">

    <!-- 4 surrounding dark rectangles forming the mask cutout -->
    <Grid Background="Transparent">
        <!-- Top darkening rect -->
        <Border x:Name="MaskTop" Background="#80000000" VerticalAlignment="Top" HorizontalAlignment="Stretch" />

        <!-- Bottom darkening rect -->
        <Border x:Name="MaskBottom" Background="#80000000" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />

        <!-- Left darkening rect -->
        <Border x:Name="MaskLeft" Background="#80000000" HorizontalAlignment="Left" />

        <!-- Right darkening rect -->
        <Border x:Name="MaskRight" Background="#80000000" HorizontalAlignment="Right" />

        <!-- Region boundary outline (subtle primary colored stroke) -->
        <Border x:Name="CutoutBorder"
            BorderBrush="{StaticResource PrimaryAccentBrush}"
            BorderThickness="2"
            CornerRadius="4"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />
    </Grid>
</Window>
