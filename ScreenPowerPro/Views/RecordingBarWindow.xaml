<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenPowerPro.Views.RecordingBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Kayıt Kontrol">

    <Grid Background="Transparent" PointerPressed="OnPointerPressed" PointerMoved="OnPointerMoved" PointerReleased="OnPointerReleased">
        <Grid.Resources>
            <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="RecIndicator" 
                                 Storyboard.TargetProperty="Opacity" 
                                 From="1.0" To="0.2" Duration="0:0:1" AutoReverse="True"/>
            </Storyboard>
        </Grid.Resources>
        
        <!-- Floating Pill Container -->
        <Border Background="#E61E1F27" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="28" Padding="20,10" HorizontalAlignment="Center" VerticalAlignment="Center"
                Shadow="{ThemeResource SharedShadow}">
            
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <!-- Red Pulse Recording Indicator -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse x:Name="RecIndicator" Fill="#EF4444" Width="10" Height="10" />
                    <TextBlock Text="Kayıt Ediliyor" FontSize="12" FontWeight="SemiBold" Foreground="#E3E1EC" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Timer Display -->
                <TextBlock x:Name="TimerTextBlock" Text="00:00:00" FontSize="14" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" Margin="4,0" />

                <!-- Separator -->
                <Border Width="1" Height="20" Background="#33FFFFFF" />

                <!-- Stop Recording Button -->
                <Button Click="OnStopClicked" ToolTipService.ToolTip="Kaydı Durdur ve Düzenle" 
                        Background="Transparent" BorderThickness="0" CornerRadius="16" Padding="8"
                        Foreground="#EF4444">
                    <Button.Content>
                        <FontIcon Glyph="&#xE71A;" FontSize="18" Foreground="#EF4444" />
                    </Button.Content>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
