<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenPowerPro.Views.RecordingBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Kayıt Kontrol">

    <Grid Background="Transparent">
        <!-- Floating Pill Container -->
        <Border Background="#20212B" BorderBrush="#3A3B4C" BorderThickness="1" CornerRadius="24" Padding="16,8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">

                <!-- Red Pulse Recording Indicator -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#EF4444" CornerRadius="5" Width="10" Height="10" />
                    <TextBlock Text="REC" FontSize="11" FontWeight="Bold" Foreground="#EF4444" CharacterSpacing="50" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Timer Display -->
                <TextBlock x:Name="TimerTextBlock" Text="00:00:00" FontSize="14" FontWeight="SemiBold" Foreground="#E3E1EC" VerticalAlignment="Center" Margin="4,0" />

                <!-- Separator -->
                <Border Width="1" Height="18" Background="#3A3B4C" />

                <!-- Stop Recording Button -->
                <Button Click="OnStopClicked" ToolTipService.ToolTip="Kaydı Durdur ve Düzenle" Background="#DC2626" BorderThickness="0" CornerRadius="14" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="White" />
                        <TextBlock Text="Durdur" FontSize="12" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
