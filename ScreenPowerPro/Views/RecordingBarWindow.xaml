<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenPowerPro.Views.RecordingBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Kayıt Kontrol Paneli">

    <!-- Seamless Floating Obsidian Capsule (No white borders) -->
    <Grid Background="#161722"
        PointerPressed="OnPointerPressed"
        PointerMoved="OnPointerMoved"
        PointerReleased="OnPointerReleased"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

        <Grid.Resources>
            <!-- Recording Pulse Storyboard -->
            <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="RecIndicator"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1.0" To="0.25" Duration="0:0:1" AutoReverse="True"/>
                <DoubleAnimation Storyboard.TargetName="RecGlow"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.6" To="0.0" Duration="0:0:1" AutoReverse="True"/>
            </Storyboard>

            <!-- Stop Button Loading Blink / Pulse Storyboard -->
            <Storyboard x:Name="StopLoadingStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="StopLoadingPanel"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1.0" To="0.2" Duration="0:0:0.6" AutoReverse="True"/>
            </Storyboard>

            <Style x:Key="BarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#252736" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <!-- Modern Obsidian Floating Pill Container (BorderThickness 0: No white borders) -->
        <Border x:Name="BarBorder"
            Background="#161722"
            BorderThickness="0"
            CornerRadius="16"
            Padding="12,6"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">

            <StackPanel x:Name="BarContentPanel" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <!-- Drag Grip Icon -->
                <FontIcon Glyph="&#xE700;" FontSize="11" Foreground="#8E8E9F" Opacity="0.6" Margin="2,0,2,0"/>

                <!-- Pulsing Recording Dot & Status -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Grid Width="14" Height="14">
                        <Ellipse x:Name="RecGlow" Fill="#EF4444" Width="14" Height="14" Opacity="0.5"/>
                        <Ellipse x:Name="RecIndicator" Fill="#EF4444" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="StatusTextBlock" Text="KAYIT" FontSize="11" FontWeight="Bold"
                        Foreground="#EF4444" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Live Timer Display -->
                <Border Background="#252736" CornerRadius="8" Padding="9,4" BorderThickness="0">
                    <TextBlock x:Name="TimerTextBlock" Text="00:00:00"
                        FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                        Foreground="{StaticResource PrimaryAccentBrush}"
                        VerticalAlignment="Center" />
                </Border>

                <!-- Separator -->
                <Rectangle Width="1" Height="20" Fill="#2B2D3D" />

                <!-- Pause / Resume Button -->
                <Button x:Name="BtnPause" Click="OnPauseClicked"
                    Style="{StaticResource BarButtonStyle}"
                    ToolTipService.ToolTip="Duraklat / Devam Et">
                    <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                </Button>

                <!-- Modern Stop & Finish Button with Loading State (Pulsing "Loading...") -->
                <Button x:Name="BtnStop" Click="OnStopClicked"
                    ToolTipService.ToolTip="Kaydı Tamamla ve Düzenleyiciye Geç"
                    CornerRadius="12" Padding="12,0" Height="36" BorderThickness="0"
                    MinWidth="115">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#DC2626" Offset="0.0"/>
                            <GradientStop Color="#EF4444" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Normal State: Stop Icon + "Kaydı Bitir" -->
                        <StackPanel x:Name="StopNormalPanel" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Border Width="16" Height="16" CornerRadius="4" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE71A;" FontSize="9" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TbStopNormalText" Text="Kaydı Bitir" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Loading State: ProgressRing + Pulsing "Loading..." -->
                        <StackPanel x:Name="StopLoadingPanel" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Visibility="Collapsed">
                            <ProgressRing IsActive="True" Width="14" Height="14" Foreground="White" />
                            <TextBlock x:Name="TbStopLoadingText" Text="Loading..." FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Cancel Button -->
                <Button x:Name="BtnCancelRec" Click="OnCancelClicked"
                    Style="{StaticResource BarButtonStyle}"
                    ToolTipService.ToolTip="Kaydı İptal Et">
                    <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="#8E8E9F" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
