<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenPowerPro.Views.RegionSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Bölge Seçimi">

    <Grid Background="#66000000" x:Name="RootGrid"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased"
          KeyDown="OnKeyDown">
        
        <Canvas x:Name="SelectionCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Overlay to darken unselected areas -->
            <Path x:Name="OverlayPath" Fill="#66000000" Stretch="None" />
            
            <Rectangle x:Name="SelectionRect" 
                       Stroke="{StaticResource PrimaryAccentBrush}" 
                       StrokeThickness="2" 
                       Fill="#33C0C1FF" 
                       Visibility="Collapsed" />

            <Border x:Name="InstructionBadge" 
                    Background="{StaticResource SurfaceContainerBrush}" 
                    BorderBrush="{StaticResource BorderSubtleBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16,12" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="Kayıt Alınacak Bölgeyi Seçin" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="İptal etmek için ESC'ye basın" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            
            <Border x:Name="SizeBadge" 
                    Background="{StaticResource SurfaceHighBrush}" 
                    CornerRadius="4" 
                    Padding="8,4" 
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Text="0x0" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>
        </Canvas>
    </Grid>
</Window>
