<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenPowerPro.Views.TeleprompterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Teleprompter">

    <Grid Background="#E6121319">
        <Grid.RowDefinitions>
            <!-- Header / Drag Bar -->
            <RowDefinition Height="46" />
            <!-- Text Display / Editor Area -->
            <RowDefinition Height="*" />
            <!-- Control Toolbar -->
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#33FFFFFF" Padding="16,0"
            PointerPressed="OnHeaderPointerPressed"
            PointerMoved="OnHeaderPointerMoved"
            PointerReleased="OnHeaderPointerReleased">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" Background="#33C0C1FF">
                        <TextBlock Text="A" FontSize="13" FontWeight="Bold" Foreground="#C0C1FF"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Teleprompter" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="(Sürükleyip konumlandırabilirsiniz)"
                    FontSize="11" Foreground="#8E8E9F" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button Grid.Column="2" Click="OnCloseClicked"
                    Background="Transparent" BorderThickness="0" CornerRadius="6" Width="28" Height="28" Padding="0">
                    <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="#CCCCCC"/>
                </Button>
            </Grid>
        </Border>

        <!-- Text Display / ScrollViewer Area -->
        <ScrollViewer x:Name="ScriptScrollViewer" Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
            <TextBox x:Name="ScriptTextBox"
                PlaceholderText="Buraya konuşma metninizi veya notlarınızı yazın ya da yapıştırın..."
                TextWrapping="Wrap"
                AcceptsReturn="True"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#F1F1F5"
                FontSize="22"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>
        </ScrollViewer>

        <!-- Control Toolbar -->
        <Border Grid.Row="2" Background="#1AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Font Size Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Boyut:" FontSize="11" Foreground="#8E8E9F" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Button Click="OnDecreaseFontSize" Background="#26FFFFFF" BorderThickness="0" CornerRadius="4" Width="28" Height="28" Padding="0">
                        <FontIcon Glyph="&#xE738;" FontSize="11" Foreground="White"/>
                    </Button>
                    <TextBlock x:Name="TbFontSize" Text="22" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Width="20" TextAlignment="Center"/>
                    <Button Click="OnIncreaseFontSize" Background="#26FFFFFF" BorderThickness="0" CornerRadius="4" Width="28" Height="28" Padding="0">
                        <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="White"/>
                    </Button>
                </StackPanel>

                <!-- Scroll Play / Pause and Speed -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnPlayPauseScroll" Click="OnToggleScroll"
                        Background="#2563EB" BorderThickness="0" CornerRadius="16" Height="32" Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="IconPlayPause" Glyph="&#xE768;" FontSize="12" Foreground="White"/>
                            <TextBlock x:Name="TbPlayPause" Text="Başlat" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Hız:" FontSize="11" Foreground="#8E8E9F" VerticalAlignment="Center"/>
                    <Slider x:Name="SliderSpeed" Minimum="1" Maximum="10" Value="3" Width="100" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Reset Scroll -->
                <Button Grid.Column="2" Click="OnResetScroll"
                    Background="#26FFFFFF" BorderThickness="0" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="Başa Dön" FontSize="11" Foreground="#D1D1DB"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
